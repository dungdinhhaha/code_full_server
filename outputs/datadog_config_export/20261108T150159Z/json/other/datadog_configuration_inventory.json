{
  "logs_pipelines": [
    {
      "filter": {
        "query": "service:smiot-smart-farm source:python"
      },
      "id": "8ew5bDboTCOzMMNf8S7apg",
      "isEnabled": true,
      "isReadOnly": false,
      "name": "SMIOT application logs and trace correlation",
      "processors": [
        {
          "grok": {
            "matchRules": "smiot \\[%{date(\"yyyy-MM-dd HH:mm:ss\"):timestamp}\\] \\[%{word:level}\\] \\[%{notSpace:logger}\\] %{data::json}",
            "supportRules": ""
          },
          "isEnabled": true,
          "name": "SMIOT structured application log",
          "samples": [
            "[2026-11-02 22:14:10] [INFO] [OBSERVABILITY] {\"event\":\"smiot_trace_span\",\"operation\":\"farm/sensor\",\"trace_id\":\"142108199789153463254966165644213917650\",\"span_id\":\"13449144757796679757\"}"
          ],
          "source": "message",
          "type": "grok-parser"
        },
        {
          "isEnabled": true,
          "name": "SMIOT log timestamp",
          "sources": [
            "timestamp"
          ],
          "type": "date-remapper"
        },
        {
          "isEnabled": true,
          "name": "SMIOT log level",
          "sources": [
            "level"
          ],
          "type": "status-remapper"
        },
        {
          "isEnabled": true,
          "name": "SMIOT trace correlation",
          "sources": [
            "trace_id"
          ],
          "type": "trace-id-remapper"
        },
        {
          "isEnabled": true,
          "name": "SMIOT span correlation",
          "overrideOnConflict": false,
          "preserveSource": true,
          "sourceType": "attribute",
          "sources": [
            "span_id"
          ],
          "target": "dd.span_id",
          "targetType": "attribute",
          "type": "attribute-remapper"
        }
      ],
      "tags": [],
      "type": "pipeline"
    },
    {
      "filter": {
        "query": "source:python"
      },
      "id": "JTbuxUjdRBSik-7UoTJP6g",
      "isEnabled": true,
      "isReadOnly": true,
      "name": "python",
      "processors": [
        {
          "grok": {
            "matchRules": "traceback_format (%{_python_prefix}|%{_datadog_prefix})\\s+%{_message_with_keyvalue}Traceback \\(most recent call last\\):(?s)\\s*%{data:error.stack}\npython_format (%{_python_prefix}|%{_datadog_prefix})\\s+%{_message_with_keyvalue}\npython_fallback %{date(\"yyyy-MM-dd'T'HH:mm:ss','SSS\"):timestamp}\\s+%{word:levelname}\\s+%{_message_with_keyvalue}((\\n|\\t)%{data:error.stack})?\n#Samples\n#2017-12-19T14:37:58,995 INFO  [process.name] [20081] this is my python log\n# Datadog format\n#2019-01-07 15:20:15,972 DEBUG [flask.app] [app.py:100] [dd.trace_id=5688176451479556031 dd.span_id=4663104081780224235] - Hook: teardown_appcontext\n",
            "supportRules": "_datadog_prefix (%{date(\"yyyy-MM-dd HH:mm:ss,SSS\"):timestamp}|%{date(\"yyyy-MM-dd H:mm:ss,SSS\"):timestamp}) %{word:levelname}\\s+\\[%{notSpace:process.name}\\]\\s+\\[%{notSpace:filename}:%{number:lineno}\\]\\s+\\[%{data::keyvalue}dd.trace_id=%{word:dd.trace_id} dd.span_id=%{word:dd.span_id}\\] -\n_python_prefix %{date(\"yyyy-MM-dd'T'HH:mm:ss','SSS\"):timestamp}\\s+%{word:levelname}\\s+\\[%{notSpace:process.name}\\]\\s+\\[%{integer:process.id}\\]\n_message_with_keyvalue %{regex(\"(?<message>.*)\")::keyvalue}\n"
          },
          "isEnabled": true,
          "name": "Parsing python default format",
          "samples": [
            "2017-12-19T14:37:58,995 INFO  [process.name] [20081] this is my python log",
            "2019-01-07 15:20:15,972 DEBUG [flask.app] [app.py:100] [dd.trace_id=5688176451479556031 dd.span_id=4663104081780224235] - Hook: teardown_appcontext",
            "2020-03-20 14:15:07,124 INFO [root] [app.py:78] [dd.service=excelsior dd.env=prod dd.version=abc123 dd.trace_id=9659687005038611690 dd.span_id=6632586210846541907] - This is a test of info logs",
            "2021-07-09 8:58:31,137 WARNING [root] [views.py:42] [dd.service=datadoggo dd.env=prod dd.version=abc546 dd.trace_id=2296056412404370861 dd.span_id=16818077145337196836] - New post view.",
            "2017-12-26T10:44:59,311 ERROR [dd.dogweb.lib.static_asset] [20081] rid=b0RV4J Error reading statics_version file.Traceback (most recent call last): File \"/home/pythonrepo/lib/asset.py\", line 16, in version    with open(\"/etc/statics_version.txt\", \"r\") as statics_version_file: IOError: [Errno 2] No such file or directory: /etc/statics_version.txt"
          ],
          "source": "message",
          "type": "grok-parser"
        },
        {
          "isEnabled": true,
          "name": "Define `timestamp` as the official date of the log",
          "sources": [
            "timestamp"
          ],
          "type": "date-remapper"
        },
        {
          "isEnabled": true,
          "name": "Define `levelname` as the official status of the log",
          "sources": [
            "levelname"
          ],
          "type": "status-remapper"
        },
        {
          "isEnabled": true,
          "name": "Define `message` as the official message of the log",
          "sources": [
            "message"
          ],
          "type": "message-remapper"
        },
        {
          "isEnabled": true,
          "name": "Map `traceback` to `error.stack`",
          "overrideOnConflict": false,
          "preserveSource": false,
          "sourceType": "attribute",
          "sources": [
            "traceback"
          ],
          "target": "error.stack",
          "targetType": "attribute",
          "type": "attribute-remapper"
        },
        {
          "isEnabled": true,
          "name": "Map `name` to `logger.name`",
          "overrideOnConflict": false,
          "preserveSource": false,
          "sourceType": "attribute",
          "sources": [
            "name"
          ],
          "target": "logger.name",
          "targetType": "attribute",
          "type": "attribute-remapper"
        },
        {
          "isEnabled": true,
          "name": "Map `threadName` to `logger.thread_name`",
          "overrideOnConflict": false,
          "preserveSource": false,
          "sourceType": "attribute",
          "sources": [
            "threadName"
          ],
          "target": "logger.thread_name",
          "targetType": "attribute",
          "type": "attribute-remapper"
        },
        {
          "isEnabled": true,
          "name": "Map `exc_info` to `error.stack`",
          "overrideOnConflict": false,
          "preserveSource": true,
          "sourceType": "attribute",
          "sources": [
            "exc_info"
          ],
          "target": "error.stack",
          "targetType": "attribute",
          "type": "attribute-remapper"
        },
        {
          "grok": {
            "matchRules": "parsing_traceback File \"%{notSpace:filename}\", line %{integer:lineno}.*\\s+%{regex(\"[a-zA-Z]*Error[a-zA-Z]*\"):error.kind}: %{data:error.message}\n",
            "supportRules": ""
          },
          "isEnabled": true,
          "name": "Parsing python traceback",
          "samples": [
            "File \"/home/pythonrepo/lib/asset.py\", line 16, in version    with open(\"/etc/statics_version.txt\", \"r\") as statics_version_file: IOError: [Errno 2] No such file or directory: /etc/statics_version.txt"
          ],
          "source": "error.stack",
          "type": "grok-parser"
        },
        {
          "isEnabled": true,
          "name": "Map `extra.dd.span_id`, `record.extra.dd.span_id` to `dd.span_id`",
          "overrideOnConflict": true,
          "preserveSource": false,
          "sourceType": "attribute",
          "sources": [
            "extra.dd.span_id",
            "record.extra.dd.span_id"
          ],
          "target": "dd.span_id",
          "targetType": "attribute",
          "type": "attribute-remapper"
        },
        {
          "isEnabled": true,
          "name": "Define `dd.trace_id`, `extra.dd.trace_id`, `record.extra.dd.trace_id` as the official trace ID of the log",
          "sources": [
            "dd.trace_id",
            "extra.dd.trace_id",
            "record.extra.dd.trace_id"
          ],
          "type": "trace-id-remapper"
        },
        {
          "isEnabled": true,
          "name": "Map attribute `dd.env`, `extra.dd.env`, `record.extra.dd.env` to tag `env`",
          "overrideOnConflict": true,
          "preserveSource": false,
          "sourceType": "attribute",
          "sources": [
            "dd.env",
            "extra.dd.env",
            "record.extra.dd.env"
          ],
          "target": "env",
          "targetType": "tag",
          "type": "attribute-remapper"
        },
        {
          "isEnabled": true,
          "name": "Map attribute `dd.version`, `extra.dd.version`, `record.extra.dd.version` to tag `version`",
          "overrideOnConflict": true,
          "preserveSource": false,
          "sourceType": "attribute",
          "sources": [
            "dd.version",
            "extra.dd.version",
            "record.extra.dd.version"
          ],
          "target": "version",
          "targetType": "tag",
          "type": "attribute-remapper"
        },
        {
          "isEnabled": true,
          "name": "Define `dd.service`, `extra.dd.service`, `record.extra.dd.service` as the official service of the log",
          "sources": [
            "dd.service",
            "extra.dd.service",
            "record.extra.dd.service"
          ],
          "type": "service-remapper"
        }
      ],
      "type": "pipeline"
    }
