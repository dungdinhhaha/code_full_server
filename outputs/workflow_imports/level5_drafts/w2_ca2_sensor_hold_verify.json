{
  "name": "SMIOT | Ca 2 | Confirm local interlock",
  "description": "Confirm soil-humidity flatline evidence. HOLD/CLEAR remains owned by the application local interlock; this workflow never sends actuator commands or claims physical sensor recovery.",
  "tags": [
    "env:demo",
    "evidence:required",
    "maturity:level5-design",
    "project:smiot",
    "safety:fail-closed",
    "safety:read-only",
    "scenario:soil-humidity-flatline",
    "service:smiot-smart-farm"
  ],
  "published": false,
  "sensitivePrivileges": false,
  "spec": {
    "handle": "smiot-ca2-confirm-local-interlock",
    "triggers": [
      {
        "monitorTrigger": {
          "rateLimit": {
            "count": 1,
            "interval": "300s"
          }
        },
        "startStepNames": [
          "query_flatline_and_interlock"
        ]
      }
    ],
    "steps": [
      {
        "name": "query_flatline_and_interlock",
        "actionId": "com.datadoghq.dd.metrics.queryScalarData",
        "display": {
          "bounds": {
            "x": 0,
            "y": 96
          }
        },
        "errorHandlers": [
          {
            "fallbackStepName": "Echo_query_failed",
            "retryStrategy": {
              "kind": "RETRY_STRATEGY_LINEAR",
              "linear": {
                "interval": "1s",
                "maxRetries": 1
              }
            }
          }
        ],
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "verify_evidence_available"
          }
        ],
        "parameters": [
          {
            "name": "range",
            "value": "5m"
          },
          {
            "name": "queries",
            "value": [
              {
                "aggregator": "last",
                "data_source": "metrics",
                "name": "flatline",
                "query": "max:smiot.telemetry.sensor_flatline{farm:greenhouse_a,node:2}"
              }
            ]
          },
          {
            "name": "formulas",
            "value": [
              {
                "formula": "flatline"
              }
            ]
          }
        ]
      },
      {
        "name": "verify_evidence_available",
        "actionId": "com.datadoghq.core.if",
        "display": {
          "bounds": {
            "x": 0,
            "y": 216
          }
        },
        "parameters": [
          {
            "name": "joinOperator",
            "value": "and"
          },
          {
            "name": "conditions",
            "value": [
              {
                "comparisonOperator": "eq",
                "leftValue": "${ (() => { const c=Steps.query_flatline_and_interlock.data?.attributes?.columns || []; const names=[\"flatline\"]; return names.every(k => { const v=Number(c.find(x=>x.name===k)?.values?.[0]); return Number.isFinite(v); }); })() }",
                "rightValue": true
              }
            ]
          }
        ],
        "outboundEdges": [
          {
            "branchName": "true",
            "nextStepName": "If_local_interlock_confirmed"
          },
          {
            "branchName": "false",
            "nextStepName": "escalate_missing_evidence"
          }
        ]
      },
      {
        "name": "If_local_interlock_confirmed",
        "actionId": "com.datadoghq.core.if",
        "display": {
          "bounds": {
            "x": 0,
            "y": 384
          }
        },
        "outboundEdges": [
          {
            "branchName": "true",
            "nextStepName": "Echo_local_interlock_confirmed"
          },
          {
            "branchName": "false",
            "nextStepName": "Echo_escalate_missing_evidence"
          }
        ],
        "parameters": [
          {
            "name": "joinOperator",
            "value": "and"
          },
          {
            "name": "conditions",
            "value": [
              {
                "comparisonOperator": "eq",
                "leftValue": "${ (() => { const cols=Steps.query_flatline_and_interlock.data?.attributes?.columns || []; const flatline=Number(cols.find(c=>c.name===\"flatline\")?.values?.[0]); return Number.isFinite(flatline) && flatline===1; })() }",
                "rightValue": true
              }
            ]
          }
        ]
      },
      {
        "name": "Echo_local_interlock_confirmed",
        "actionId": "com.datadoghq.core.echo",
        "display": {
          "bounds": {
            "x": 0,
            "y": 552
          }
        },
        "parameters": [
          {
            "name": "value",
            "value": "CA2 | SENSOR_FLATLINE_CONFIRMED | backend metric reports 10 fresh persisted Node 2 soil-humidity samples are flat | this does not prove HOLD was acknowledged | verify the app action ledger and virtual PLC ACK; no Datadog actuator action; no auto-CLEAR | RECORD=workflow run and linked monitor event | VERIFY=check app action ledger and fresh telemetry before marking recovered; Echo is not recovery proof"
          }
        ],
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "notify_smiot_app"
          }
        ]
      },
      {
        "name": "Echo_escalate_missing_evidence",
        "actionId": "com.datadoghq.core.echo",
        "display": {
          "bounds": {
            "x": 384,
            "y": 552
          }
        },
        "parameters": [
          {
            "name": "value",
            "value": "CA2 | ESCALATE_HUMAN | flatline is not currently confirmed or metric value is unavailable | check the monitor group, source freshness, app action ledger and virtual PLC ACK | no HOLD/CLEAR from Datadog | DECISION=UNKNOWN_OR_NO_TRIGGER | ACTION=NONE | NEXT=operator review; retain uncertainty"
          }
        ],
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "notify_smiot_app"
          }
        ]
      },
      {
        "name": "Echo_query_failed",
        "actionId": "com.datadoghq.core.echo",
        "display": {
          "bounds": {
            "x": 384,
            "y": 552
          }
        },
        "parameters": [
          {
            "name": "value",
            "value": "CA2 | ESCALATE_HUMAN | Datadog flatline metric query failed | app/virtual PLC interlock remains unverified | no actuator action and no auto-CLEAR | DECISION=UNKNOWN_OR_NO_TRIGGER | ACTION=NONE | NEXT=operator review; retain uncertainty"
          }
        ],
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "notify_smiot_app"
          }
        ]
      },
      {
        "name": "escalate_missing_evidence",
        "actionId": "com.datadoghq.core.echo",
        "display": {
          "bounds": {
            "x": 384,
            "y": 552
          }
        },
        "parameters": [
          {
            "name": "value",
            "value": "W2 | DECISION=UNKNOWN | EVIDENCE=required metric column missing or non-numeric | ACTION=NONE | NEXT=operator checks telemetry source and monitor window; do not mark recovered"
          }
        ],
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "notify_smiot_app"
          }
        ]
      },
      {
        "name": "notify_smiot_app",
        "actionId": "com.datadoghq.http.request",
        "connectionLabel": "SMIOT_APP_HTTP",
        "parameters": [
          {
            "name": "verb",
            "value": "POST"
          },
          {
            "name": "url",
            "value": "https://13-238-30-218.sslip.io/api/integrations/datadog/notification"
          },
          {
            "name": "requestHeaders",
            "value": [
              {
                "key": "Content-Type",
                "value": [
                  "application/json"
                ]
              }
            ]
          },
          {
            "name": "body",
            "value": "{\"event_id\":\"{{InstanceId}}\",\"workflow_name\":\"{{WorkflowName}}\",\"workflow_id\":\"{{WorkflowId}}\",\"message\":\"Ca 2 checks a flatline metric for greenhouse_a/node 2. Confirm HOLD ACK and fresh varying Mongo samples in the app; this workflow does not send HOLD/CLEAR or claim a physical probe fault.\",\"category\":\"datadog\",\"severity\":\"warning\",\"farm_key\":\"greenhouse_a\"}"
          }
        ],
        "readinessGate": {
          "thresholdType": "ANY"
        }
      }
    ],
    "connectionEnvs": [
      {
        "env": "default",
        "connections": [
          {
            "connectionId": "0e1ab54b-a758-47ad-ab39-c9ab4e091dba",
            "label": "SMIOT_APP_HTTP"
          }
        ]
      }
    ]
  }
}
