{
  "description": "Verify explicit actuator-command-unacknowledged evidence. Never retry a command automatically; local control owns safe state. This workflow is evidence-only: it never retries a command or claims physical actuator recovery without matching command ID, ACK and device feedback. The metric can distinguish PLC pump versus inverter class, but carries no command_id or incident_id and is aggregated across farms; it cannot prove which command or physical device recovered.",
  "published": true,
  "sensitivePrivileges": false,
  "tags": [
    "env:demo",
    "evidence:required",
    "maturity:level5-design",
    "plan:workflow-09",
    "project:smiot",
    "safety:fail-closed",
    "safety:read-only",
    "service:smiot-smart-farm"
  ],
  "name": "SMIOT | W9 | Actuator acknowledgement verification",
  "spec": {
    "steps": [
      {
        "display": {
          "bounds": {
            "y": 96,
            "x": 0
          }
        },
        "errorHandlers": [
          {
            "fallbackStepName": "escalate_query_failed",
            "retryStrategy": {
              "linear": {
                "interval": "1s",
                "maxRetries": 1
              },
              "kind": "RETRY_STRATEGY_LINEAR"
            }
          }
        ],
        "name": "read_operational_signals",
        "actionId": "com.datadoghq.dd.metrics.queryScalarData",
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "verify_evidence_available"
          }
        ],
        "parameters": [
          {
            "value": "10m",
            "name": "range"
          },
          {
            "value": [
              {
                "aggregator": "last",
                "name": "plc_pump_unack",
                "query": "sum:smiot.actuator.command_unacknowledged{event:unacknowledged,actuator:plc_pump}",
                "data_source": "metrics"
              },
              {
                "aggregator": "last",
                "name": "inverter_unack",
                "query": "sum:smiot.actuator.command_unacknowledged{event:unacknowledged,actuator:inverter}",
                "data_source": "metrics"
              }
            ],
            "name": "queries"
          },
          {
            "value": [
              {
                "formula": "plc_pump_unack"
              },
              {
                "formula": "inverter_unack"
              }
            ],
            "name": "formulas"
          }
        ]
      },
      {
        "name": "verify_evidence_available",
        "actionId": "com.datadoghq.core.if",
        "display": {
          "bounds": {
            "x": 0,
            "y": 216
          }
        },
        "parameters": [
          {
            "name": "joinOperator",
            "value": "and"
          },
          {
            "name": "conditions",
            "value": [
              {
                "comparisonOperator": "eq",
                "leftValue": "${ (() => { const c=Steps.read_operational_signals.data?.attributes?.columns || []; const names=[\"plc_pump_unack\", \"inverter_unack\"]; return names.every(k => { const v=Number(c.find(x=>x.name===k)?.values?.[0]); return Number.isFinite(v); }); })() }",
                "rightValue": true
              }
            ]
          }
        ],
        "outboundEdges": [
          {
            "branchName": "true",
            "nextStepName": "classify_evidence"
          },
          {
            "branchName": "false",
            "nextStepName": "escalate_missing_evidence"
          }
        ]
      },
      {
        "display": {
          "bounds": {
            "x": 0,
            "y": 384
          }
        },
        "name": "classify_evidence",
        "outboundEdges": [
          {
            "nextStepName": "evidence_observed",
            "branchName": "true"
          },
          {
            "nextStepName": "escalate_or_review",
            "branchName": "false"
          }
        ],
        "parameters": [
          {
            "value": "and",
            "name": "joinOperator"
          },
          {
            "value": [
              {
                "comparisonOperator": "eq",
                "leftValue": "${ (() => { const c=Steps.read_operational_signals.data?.attributes?.columns || []; const p=Number(c.find(x=>x.name===\"plc_pump_unack\")?.values?.[0]); const i=Number(c.find(x=>x.name===\"inverter_unack\")?.values?.[0]); return (Number.isFinite(p) && p>0) || (Number.isFinite(i) && i>0); })() }",
                "rightValue": true
              }
            ],
            "name": "conditions"
          }
        ],
        "actionId": "com.datadoghq.core.if"
      },
      {
        "display": {
          "bounds": {
            "y": 552,
            "x": 0
          }
        },
        "name": "evidence_observed",
        "parameters": [
          {
            "value": "W9 | COMMAND_UNACKNOWLEDGED | The workflow queries separate PLC-pump and inverter counters. Inspect both columns; metrics do not carry command_id/incident_id and do not prove physical state. Retry is disabled; escalate for command/ACK/feedback verification.",
            "name": "value"
          }
        ],
        "actionId": "com.datadoghq.core.echo",
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "notify_app_evidence_observed"
          }
        ]
      },
      {
        "display": {
          "bounds": {
            "y": 552,
            "x": 0
          }
        },
        "name": "escalate_or_review",
        "parameters": [
          {
            "value": "W9 | NO_UNACK_SIGNAL | No unacknowledged command was returned or data is absent. Verify monitor and command ACK source; do not claim the actuator is healthy from missing data. | DECISION=UNKNOWN_OR_NO_TRIGGER | ACTION=NONE | NEXT=operator review; retain uncertainty",
            "name": "value"
          }
        ],
        "actionId": "com.datadoghq.core.echo",
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "notify_app_escalate_or_review"
          }
        ]
      },
      {
        "display": {
          "bounds": {
            "y": 552,
            "x": 0
          }
        },
        "name": "escalate_query_failed",
        "parameters": [
          {
            "value": "SMIOT | W9 | Actuator acknowledgement verification | DECISION=UNKNOWN | EVIDENCE=QUERY_ERROR | ACTION=NONE | NEXT=OPERATOR | Evidence unavailable; fail closed and hand to an operator. No actuator or infrastructure action.",
            "name": "value"
          }
        ],
        "actionId": "com.datadoghq.core.echo",
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "notify_app_escalate_query_failed"
          }
        ]
      },
      {
        "name": "escalate_missing_evidence",
        "actionId": "com.datadoghq.core.echo",
        "display": {
          "bounds": {
            "x": 384,
            "y": 552
          }
        },
        "parameters": [
          {
            "name": "value",
            "value": "W9 | DECISION=UNKNOWN | EVIDENCE=required metric column missing or non-numeric | ACTION=NONE | NEXT=operator checks telemetry source and monitor window; do not mark recovered"
          }
        ],
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "notify_app_escalate_missing_evidence"
          }
        ]
      },
      {
        "name": "notify_app_evidence_observed",
        "actionId": "com.datadoghq.http.request",
        "connectionLabel": "SMIOT_APP_HTTP",
        "parameters": [
          {
            "name": "verb",
            "value": "POST"
          },
          {
            "name": "url",
            "value": "https://13-238-30-218.sslip.io/api/integrations/datadog/notification"
          },
          {
            "name": "requestHeaders",
            "value": [
              {
                "key": "Content-Type",
                "value": [
                  "application/json"
                ]
              }
            ]
          },
          {
            "name": "body",
            "value": "{\"event_id\":\"{{InstanceId}}\",\"workflow_name\":\"{{WorkflowName}}\",\"workflow_id\":\"{{WorkflowId}}\",\"message\":\"W9 outcome: an actuator command is unacknowledged. Inspect the PLC pump/inverter evidence columns and verify the command and physical feedback. No retry was issued. Workflow run {{InstanceId}}.\",\"category\":\"datadog\",\"severity\":\"error\"}"
          }
        ],
        "readinessGate": {
          "thresholdType": "ANY"
        }
      },
      {
        "name": "notify_app_escalate_or_review",
        "actionId": "com.datadoghq.http.request",
        "connectionLabel": "SMIOT_APP_HTTP",
        "parameters": [
          {
            "name": "verb",
            "value": "POST"
          },
          {
            "name": "url",
            "value": "https://13-238-30-218.sslip.io/api/integrations/datadog/notification"
          },
          {
            "name": "requestHeaders",
            "value": [
              {
                "key": "Content-Type",
                "value": [
                  "application/json"
                ]
              }
            ]
          },
          {
            "name": "body",
            "value": "{\"event_id\":\"{{InstanceId}}\",\"workflow_name\":\"{{WorkflowName}}\",\"workflow_id\":\"{{WorkflowId}}\",\"message\":\"W9 outcome: no unacknowledged-command datapoint was returned. This does not prove actuator health; check monitor coverage and ACK source. Workflow run {{InstanceId}}.\",\"category\":\"datadog\",\"severity\":\"info\"}"
          }
        ],
        "readinessGate": {
          "thresholdType": "ANY"
        }
      },
      {
        "name": "notify_app_escalate_query_failed",
        "actionId": "com.datadoghq.http.request",
        "connectionLabel": "SMIOT_APP_HTTP",
        "parameters": [
          {
            "name": "verb",
            "value": "POST"
          },
          {
            "name": "url",
            "value": "https://13-238-30-218.sslip.io/api/integrations/datadog/notification"
          },
          {
            "name": "requestHeaders",
            "value": [
              {
                "key": "Content-Type",
                "value": [
                  "application/json"
                ]
              }
            ]
          },
          {
            "name": "body",
            "value": "{\"event_id\":\"{{InstanceId}}\",\"workflow_name\":\"{{WorkflowName}}\",\"workflow_id\":\"{{WorkflowId}}\",\"message\":\"W9 outcome: Datadog could not read actuator evidence. Status remains unknown; operator review is required. Workflow run {{InstanceId}}.\",\"category\":\"datadog\",\"severity\":\"error\"}"
          }
        ],
        "readinessGate": {
          "thresholdType": "ANY"
        }
      },
      {
        "name": "notify_app_escalate_missing_evidence",
        "actionId": "com.datadoghq.http.request",
        "connectionLabel": "SMIOT_APP_HTTP",
        "parameters": [
          {
            "name": "verb",
            "value": "POST"
          },
          {
            "name": "url",
            "value": "https://13-238-30-218.sslip.io/api/integrations/datadog/notification"
          },
          {
            "name": "requestHeaders",
            "value": [
              {
                "key": "Content-Type",
                "value": [
                  "application/json"
                ]
              }
            ]
          },
          {
            "name": "body",
            "value": "{\"event_id\":\"{{InstanceId}}\",\"workflow_name\":\"{{WorkflowName}}\",\"workflow_id\":\"{{WorkflowId}}\",\"message\":\"W9 outcome: required actuator metric evidence is missing. Status remains unknown; operator review is required. Workflow run {{InstanceId}}.\",\"category\":\"datadog\",\"severity\":\"warning\"}"
          }
        ],
        "readinessGate": {
          "thresholdType": "ANY"
        }
      }
    ],
    "handle": "smiot-w09-actuator-ack-verify",
    "triggers": [
      {
        "startStepNames": [
          "read_operational_signals"
        ],
        "monitorTrigger": {
          "rateLimit": {
            "count": 1,
            "interval": "300s"
          }
        }
      }
    ]
  }
}
