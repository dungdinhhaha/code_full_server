{
  "data": {
    "id": "47e95b24-db40-4cd5-b667-5b90e170b667",
    "type": "workflows",
    "attributes": {
      "createdAt": "2026-11-09T18:11:15.954871Z",
      "description": "Reads explicit command-unacknowledged telemetry and escalates for inspection. It never retries commands or claims physical actuator recovery.",
      "name": "SMIOT | W9 | Actuator acknowledgement verification",
      "published": true,
      "runAsUserMode": "owner",
      "sensitivePrivileges": false,
      "spec": {
        "triggers": [
          {
            "startStepNames": [
              "read_operational_signals"
            ],
            "monitorTrigger": {
              "rateLimit": {
                "count": 1,
                "interval": "300s"
              }
            }
          }
        ],
        "steps": [
          {
            "name": "read_operational_signals",
            "actionId": "com.datadoghq.dd.metrics.queryScalarData",
            "parameters": [
              {
                "name": "range",
                "value": "10m"
              },
              {
                "name": "queries",
                "value": [
                  {
                    "aggregator": "last",
                    "data_source": "metrics",
                    "name": "unacknowledged",
                    "query": "sum:smiot.actuator.command_unacknowledged{event:unacknowledged}"
                  }
                ]
              },
              {
                "name": "formulas",
                "value": [
                  {
                    "formula": "unacknowledged"
                  }
                ]
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "classify_evidence",
                "branchName": "main"
              }
            ],
            "errorHandlers": [
              {
                "retryStrategy": {
                  "kind": "RETRY_STRATEGY_LINEAR",
                  "linear": {
                    "interval": "1s",
                    "maxRetries": 1
                  }
                },
                "fallbackStepName": "escalate_query_failed"
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 96
              }
            }
          },
          {
            "name": "classify_evidence",
            "actionId": "com.datadoghq.core.if",
            "parameters": [
              {
                "name": "joinOperator",
                "value": "and"
              },
              {
                "name": "conditions",
                "value": [
                  {
                    "comparisonOperator": "eq",
                    "leftValue": "${ (() => { const c=Steps.read_operational_signals.data?.attributes?.columns || []; const v=Number(c.find(x=>x.name===\"unacknowledged\")?.values?.[0]); return Number.isFinite(v) && v>0; })() }",
                    "rightValue": true
                  }
                ]
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "evidence_observed",
                "branchName": "true"
              },
              {
                "nextStepName": "escalate_or_review",
                "branchName": "false"
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 264
              }
            }
          },
          {
            "name": "evidence_observed",
            "actionId": "com.datadoghq.core.echo",
            "parameters": [
              {
                "name": "value",
                "value": "W9 | COMMAND_UNACKNOWLEDGED | Check command history, PLC feedback and physical actuator state. Retry is intentionally disabled until idempotency and safe-retry policy are proven; enter safe mode per operator procedure if needed."
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 432
              }
            }
          },
          {
            "name": "escalate_or_review",
            "actionId": "com.datadoghq.core.echo",
            "parameters": [
              {
                "name": "value",
                "value": "W9 | NO_UNACK_SIGNAL | No unacknowledged command was returned or data is absent. Verify monitor and command ACK source; do not claim the actuator is healthy from missing data."
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 432
              }
            }
          },
          {
            "name": "escalate_query_failed",
            "actionId": "com.datadoghq.core.echo",
            "parameters": [
              {
                "name": "value",
                "value": "SMIOT | W9 | Actuator acknowledgement verification | QUERY_FAILED | Evidence unavailable; fail closed and hand to an operator. No actuator or infrastructure action."
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 96
              }
            }
          }
        ],
        "handle": "smiot-w09-actuator-ack-verify"
      },
      "tags": [
        "env:demo",
        "plan:workflow-09",
        "project:smiot",
        "safety:read-only",
        "service:smiot-smart-farm"
      ],
      "updatedAt": "2026-11-09T18:11:17.049686Z"
    },
    "relationships": {
      "creator": {
