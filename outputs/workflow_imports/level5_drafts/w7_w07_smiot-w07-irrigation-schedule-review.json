{
  "description": "Review soil-moisture freshness for an operator. No crop-stage envelope is assumed and no irrigation schedule or actuator is changed. This workflow is evidence-only: it does not approve or change irrigation. Any proposed schedule change requires a person and an approved crop-stage envelope. Monitor-triggered farm/node inputs scope telemetry reads to the affected node. The workflow remains advisory; no crop threshold or schedule action is inferred.",
  "published": true,
  "sensitivePrivileges": false,
  "tags": [
    "env:demo",
    "evidence:required",
    "maturity:level5-design",
    "plan:workflow-07",
    "project:smiot",
    "safety:fail-closed",
    "safety:read-only",
    "service:smiot-smart-farm"
  ],
  "name": "SMIOT | W7 | Irrigation schedule evidence review",
  "spec": {
    "steps": [
      {
        "display": {
          "bounds": {
            "y": 96,
            "x": 0
          }
        },
        "errorHandlers": [
          {
            "fallbackStepName": "escalate_query_failed",
            "retryStrategy": {
              "linear": {
                "interval": "1s",
                "maxRetries": 1
              },
              "kind": "RETRY_STRATEGY_LINEAR"
            }
          }
        ],
        "name": "read_operational_signals",
        "actionId": "com.datadoghq.dd.metrics.queryScalarData",
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "verify_evidence_available"
          }
        ],
        "parameters": [
          {
            "value": "10m",
            "name": "range"
          },
          {
            "value": [
              {
                "aggregator": "last",
                "name": "soil_humidity",
                "query": "avg:smiot.telemetry.soil_humidity{farm:{{Trigger.farm_key}},node:{{Trigger.node_id}}}",
                "data_source": "metrics"
              },
              {
                "aggregator": "last",
                "name": "sample_age_s",
                "query": "max:smiot.telemetry.sample_age_seconds{farm:{{Trigger.farm_key}},node:{{Trigger.node_id}}}",
                "data_source": "metrics"
              }
            ],
            "name": "queries"
          },
          {
            "value": [
              {
                "formula": "soil_humidity"
              },
              {
                "formula": "sample_age_s"
              }
            ],
            "name": "formulas"
          }
        ]
      },
      {
        "name": "verify_evidence_available",
        "actionId": "com.datadoghq.core.if",
        "display": {
          "bounds": {
            "x": 0,
            "y": 216
          }
        },
        "parameters": [
          {
            "name": "joinOperator",
            "value": "and"
          },
          {
            "name": "conditions",
            "value": [
              {
                "comparisonOperator": "eq",
                "leftValue": "${ (() => { const c=Steps.read_operational_signals.data?.attributes?.columns || []; const names=[\"soil_humidity\", \"sample_age_s\"]; return names.every(k => { const v=Number(c.find(x=>x.name===k)?.values?.[0]); return Number.isFinite(v); }); })() }",
                "rightValue": true
              }
            ]
          }
        ],
        "outboundEdges": [
          {
            "branchName": "true",
            "nextStepName": "classify_evidence"
          },
          {
            "branchName": "false",
            "nextStepName": "escalate_missing_evidence"
          }
        ]
      },
      {
        "display": {
          "bounds": {
            "x": 0,
            "y": 384
          }
        },
        "name": "classify_evidence",
        "outboundEdges": [
          {
            "nextStepName": "evidence_observed",
            "branchName": "true"
          },
          {
            "nextStepName": "escalate_or_review",
            "branchName": "false"
          }
        ],
        "parameters": [
          {
            "value": "and",
            "name": "joinOperator"
          },
          {
            "value": [
              {
                "comparisonOperator": "eq",
                "leftValue": "${ (() => { const c=Steps.read_operational_signals.data?.attributes?.columns || []; const a=Number(c.find(x=>x.name===\"sample_age_s\")?.values?.[0]); return Number.isFinite(a) && a>=0 && a<120; })() }",
                "rightValue": true
              }
            ],
            "name": "conditions"
          }
        ],
        "actionId": "com.datadoghq.core.if"
      },
      {
        "display": {
          "bounds": {
            "y": 552,
            "x": 0
          }
        },
        "name": "evidence_observed",
        "parameters": [
          {
            "value": "W7 | FRESH_INPUTS_FOR_REVIEW | Soil moisture sample is fresh. Compare it with the approved farm schedule and crop-stage envelope before any human-approved change. This workflow does not modify irrigation. | RECORD=workflow run and linked monitor event | VERIFY=check app action ledger and fresh telemetry before marking recovered; Echo is not recovery proof",
            "name": "value"
          }
        ],
        "actionId": "com.datadoghq.core.echo",
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "notify_app_evidence_observed"
          }
        ]
      },
      {
        "display": {
          "bounds": {
            "y": 552,
            "x": 0
          }
        },
        "name": "escalate_or_review",
        "parameters": [
          {
            "value": "W7 | SCHEDULE_CHANGE_BLOCKED | Soil-moisture evidence is stale or unavailable. Keep the existing safe schedule, check sensor/persistence, and escalate; no automatic irrigation change. | DECISION=UNKNOWN_OR_NO_TRIGGER | ACTION=NONE | NEXT=operator review; retain uncertainty",
            "name": "value"
          }
        ],
        "actionId": "com.datadoghq.core.echo",
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "notify_app_escalate_or_review"
          }
        ]
      },
      {
        "display": {
          "bounds": {
            "y": 552,
            "x": 0
          }
        },
        "name": "escalate_query_failed",
        "parameters": [
          {
            "value": "SMIOT | W7 | Irrigation schedule evidence review | DECISION=UNKNOWN | EVIDENCE=QUERY_ERROR | ACTION=NONE | NEXT=OPERATOR | Evidence unavailable; fail closed and hand to an operator. No actuator or infrastructure action.",
            "name": "value"
          }
        ],
        "actionId": "com.datadoghq.core.echo",
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "notify_app_escalate_query_failed"
          }
        ]
      },
      {
        "name": "escalate_missing_evidence",
        "actionId": "com.datadoghq.core.echo",
        "display": {
          "bounds": {
            "x": 384,
            "y": 552
          }
        },
        "parameters": [
          {
            "name": "value",
            "value": "W7 | DECISION=UNKNOWN | EVIDENCE=required metric column missing or non-numeric | ACTION=NONE | NEXT=operator checks telemetry source and monitor window; do not mark recovered"
          }
        ],
        "outboundEdges": [
          {
            "branchName": "main",
            "nextStepName": "notify_app_escalate_missing_evidence"
          }
        ]
      },
      {
        "name": "notify_app_evidence_observed",
        "actionId": "com.datadoghq.http.request",
        "connectionLabel": "SMIOT_APP_HTTP",
        "parameters": [
          {
            "name": "verb",
            "value": "POST"
          },
          {
            "name": "url",
            "value": "https://13-238-30-218.sslip.io/api/integrations/datadog/notification"
          },
          {
            "name": "requestHeaders",
            "value": [
              {
                "key": "Content-Type",
                "value": [
                  "application/json"
                ]
              }
            ]
          },
          {
            "name": "body",
            "value": "{\"event_id\":\"{{InstanceId}}\",\"workflow_name\":\"{{WorkflowName}}\",\"workflow_id\":\"{{WorkflowId}}\",\"message\":\"W7 outcome: fresh soil-moisture inputs are available for operator review. No irrigation schedule or actuator was changed. Workflow run {{InstanceId}}.\",\"category\":\"datadog\",\"severity\":\"info\"}"
          }
        ],
        "readinessGate": {
          "thresholdType": "ANY"
        }
      },
      {
        "name": "notify_app_escalate_or_review",
        "actionId": "com.datadoghq.http.request",
        "connectionLabel": "SMIOT_APP_HTTP",
        "parameters": [
          {
            "name": "verb",
            "value": "POST"
          },
          {
            "name": "url",
            "value": "https://13-238-30-218.sslip.io/api/integrations/datadog/notification"
          },
          {
            "name": "requestHeaders",
            "value": [
              {
                "key": "Content-Type",
                "value": [
                  "application/json"
                ]
              }
            ]
          },
          {
            "name": "body",
            "value": "{\"event_id\":\"{{InstanceId}}\",\"workflow_name\":\"{{WorkflowName}}\",\"workflow_id\":\"{{WorkflowId}}\",\"message\":\"W7 outcome: soil-moisture evidence is stale or the review condition is not met. Keep the existing safe schedule and ask an operator to inspect; no irrigation action was taken. Workflow run {{InstanceId}}.\",\"category\":\"datadog\",\"severity\":\"warning\"}"
          }
        ],
        "readinessGate": {
          "thresholdType": "ANY"
        }
      },
      {
        "name": "notify_app_escalate_query_failed",
        "actionId": "com.datadoghq.http.request",
        "connectionLabel": "SMIOT_APP_HTTP",
        "parameters": [
          {
            "name": "verb",
            "value": "POST"
          },
          {
            "name": "url",
            "value": "https://13-238-30-218.sslip.io/api/integrations/datadog/notification"
          },
          {
            "name": "requestHeaders",
            "value": [
              {
                "key": "Content-Type",
                "value": [
                  "application/json"
                ]
              }
            ]
          },
          {
            "name": "body",
            "value": "{\"event_id\":\"{{InstanceId}}\",\"workflow_name\":\"{{WorkflowName}}\",\"workflow_id\":\"{{WorkflowId}}\",\"message\":\"W7 outcome: Datadog could not read the required evidence. Status remains unknown; operator review is required. Workflow run {{InstanceId}}.\",\"category\":\"datadog\",\"severity\":\"error\"}"
          }
        ],
        "readinessGate": {
          "thresholdType": "ANY"
        }
      },
      {
        "name": "notify_app_escalate_missing_evidence",
        "actionId": "com.datadoghq.http.request",
        "connectionLabel": "SMIOT_APP_HTTP",
        "parameters": [
          {
            "name": "verb",
            "value": "POST"
          },
          {
            "name": "url",
            "value": "https://13-238-30-218.sslip.io/api/integrations/datadog/notification"
          },
          {
            "name": "requestHeaders",
            "value": [
              {
                "key": "Content-Type",
                "value": [
                  "application/json"
                ]
              }
            ]
          },
          {
            "name": "body",
            "value": "{\"event_id\":\"{{InstanceId}}\",\"workflow_name\":\"{{WorkflowName}}\",\"workflow_id\":\"{{WorkflowId}}\",\"message\":\"W7 outcome: required metric evidence is missing. Status remains unknown; operator review is required. Workflow run {{InstanceId}}.\",\"category\":\"datadog\",\"severity\":\"warning\"}"
          }
        ],
        "readinessGate": {
          "thresholdType": "ANY"
        }
      }
    ],
    "handle": "smiot-w07-irrigation-schedule-review",
    "triggers": [
      {
        "startStepNames": [
          "read_operational_signals"
        ],
        "monitorTrigger": {
          "rateLimit": {
            "count": 1,
            "interval": "300s"
          }
        }
      }
    ],
    "inputSchema": {
      "parameters": [
        {
          "name": "farm_key",
          "type": "STRING"
        },
        {
          "name": "node_id",
          "type": "STRING"
        }
      ]
    }
  }
}
