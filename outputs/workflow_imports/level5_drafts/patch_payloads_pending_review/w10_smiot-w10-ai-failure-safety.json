{
  "data": {
    "id": "50b3dc85-dd20-4220-bda1-ec78d2a3d00f",
    "type": "workflows",
    "attributes": {
      "name": "SMIOT | W10 | AI failure safety verification",
      "description": "Checks provider failure and AI latency evidence, then asks operator to verify app fail-safe HOLD and action ledger. No AI-generated irrigation action is issued.",
      "published": true,
      "runAs": {
        "type": "owner"
      },
      "sensitivePrivileges": false,
      "tags": [
        "env:demo",
        "plan:workflow-10",
        "project:smiot",
        "safety:read-only",
        "service:smiot-smart-farm"
      ],
      "spec": {
        "steps": [
          {
            "display": {
              "bounds": {
                "y": 96,
                "x": 0
              }
            },
            "errorHandlers": [
              {
                "fallbackStepName": "escalate_query_failed",
                "retryStrategy": {
                  "linear": {
                    "interval": "1s",
                    "maxRetries": 1
                  },
                  "kind": "RETRY_STRATEGY_LINEAR"
                }
              }
            ],
            "name": "read_operational_signals",
            "actionId": "com.datadoghq.dd.metrics.queryScalarData",
            "outboundEdges": [
              {
                "branchName": "main",
                "nextStepName": "verify_evidence_available"
              }
            ],
            "parameters": [
              {
                "value": "10m",
                "name": "range"
              },
              {
                "value": [
                  {
                    "aggregator": "last",
                    "name": "provider_failure",
                    "query": "sum:smiot.ai.provider_failure{status:provider_error}",
                    "data_source": "metrics"
                  },
                  {
                    "aggregator": "last",
                    "name": "ask_latency_ms",
                    "query": "max:smiot.ai.ask_latency_ms{*}",
                    "data_source": "metrics"
                  },
                  {
                    "aggregator": "last",
                    "name": "provider_success",
                    "query": "sum:smiot.ai.provider_success{*}",
                    "data_source": "metrics"
                  }
                ],
                "name": "queries"
              },
              {
                "value": [
                  {
                    "formula": "provider_failure"
                  },
                  {
                    "formula": "ask_latency_ms"
                  },
                  {
                    "formula": "provider_success"
                  }
                ],
                "name": "formulas"
              }
            ]
          },
          {
            "name": "verify_evidence_available",
            "actionId": "com.datadoghq.core.if",
            "display": {
              "bounds": {
                "x": 0,
                "y": 216
              }
            },
            "parameters": [
              {
                "name": "joinOperator",
                "value": "and"
              },
              {
                "name": "conditions",
                "value": [
                  {
                    "comparisonOperator": "eq",
                    "leftValue": "${ (() => { const c=Steps.read_operational_signals.data?.attributes?.columns || []; return [\"provider_failure\",\"ask_latency_ms\",\"provider_success\"].every(k => Number.isFinite(Number(c.find(x=>x.name===k)?.values?.[0]))); })() }",
                    "rightValue": true
                  }
                ]
              }
            ],
            "outboundEdges": [
              {
                "branchName": "true",
                "nextStepName": "classify_provider_error"
              },
              {
                "branchName": "false",
                "nextStepName": "escalate_missing_evidence"
              }
            ]
          },
          {
            "display": {
              "bounds": {
                "y": 552,
                "x": 0
              }
            },
            "name": "escalate_query_failed",
            "parameters": [
              {
                "value": "SMIOT | W10 | AI failure safety verification | DECISION=UNKNOWN | EVIDENCE=QUERY_ERROR | ACTION=NONE | NEXT=OPERATOR | Evidence unavailable; fail closed and hand to an operator. No actuator or infrastructure action.",
                "name": "value"
              }
            ],
            "actionId": "com.datadoghq.core.echo",
            "outboundEdges": [
              {
                "branchName": "main",
                "nextStepName": "notify_smiot_app"
              }
            ]
          },
          {
            "name": "escalate_missing_evidence",
            "actionId": "com.datadoghq.core.echo",
            "display": {
              "bounds": {
                "x": 384,
                "y": 552
              }
            },
            "parameters": [
              {
                "name": "value",
                "value": "W10 | DECISION=UNKNOWN | EVIDENCE=required metric column missing or non-numeric | ACTION=NONE | NEXT=operator checks telemetry source and monitor window; do not mark recovered"
              }
            ],
            "outboundEdges": [
              {
                "branchName": "main",
                "nextStepName": "notify_smiot_app"
              }
            ],
            "readinessGate": {
              "thresholdType": "ANY"
            }
          },
          {
            "name": "classify_provider_error",
            "actionId": "com.datadoghq.core.if",
            "display": {
              "bounds": {
                "x": 0,
                "y": 384
              }
            },
            "parameters": [
              {
                "name": "joinOperator",
                "value": "and"
              },
              {
                "name": "conditions",
                "value": [
                  {
                    "comparisonOperator": "eq",
                    "leftValue": "${ (() => { const c=Steps.read_operational_signals.data?.attributes?.columns || []; const v=Number(c.find(x=>x.name===\"provider_failure\")?.values?.[0]); return Number.isFinite(v) && v>0; })() }",
                    "rightValue": true
                  }
                ]
              }
            ],
            "outboundEdges": [
              {
                "branchName": "true",
                "nextStepName": "provider_error_observed"
              },
              {
                "branchName": "false",
                "nextStepName": "classify_latency"
              }
            ]
          },
          {
            "name": "classify_latency",
            "actionId": "com.datadoghq.core.if",
            "display": {
              "bounds": {
                "x": 384,
                "y": 384
              }
            },
            "parameters": [
              {
                "name": "joinOperator",
                "value": "and"
              },
              {
                "name": "conditions",
                "value": [
                  {
                    "comparisonOperator": "eq",
                    "leftValue": "${ (() => { const c=Steps.read_operational_signals.data?.attributes?.columns || []; const v=Number(c.find(x=>x.name===\"ask_latency_ms\")?.values?.[0]); return Number.isFinite(v) && v>5000; })() }",
                    "rightValue": true
                  }
                ]
              }
            ],
            "outboundEdges": [
              {
                "branchName": "true",
                "nextStepName": "latency_degraded"
              },
              {
                "branchName": "false",
                "nextStepName": "classify_provider_success"
              }
            ]
          },
          {
            "name": "classify_provider_success",
            "actionId": "com.datadoghq.core.if",
            "display": {
              "bounds": {
                "x": 768,
                "y": 384
              }
            },
            "parameters": [
              {
                "name": "joinOperator",
                "value": "and"
              },
              {
                "name": "conditions",
                "value": [
                  {
                    "comparisonOperator": "eq",
                    "leftValue": "${ (() => { const c=Steps.read_operational_signals.data?.attributes?.columns || []; const v=Number(c.find(x=>x.name===\"provider_success\")?.values?.[0]); const f=Number(c.find(x=>x.name===\"provider_failure\")?.values?.[0]); return Number.isFinite(v) && v>0 && Number.isFinite(f) && f===0; })() }",
                    "rightValue": true
                  }
                ]
              }
            ],
            "outboundEdges": [
              {
                "branchName": "true",
                "nextStepName": "no_ai_breach"
              },
              {
                "branchName": "false",
                "nextStepName": "escalate_missing_evidence"
              }
            ]
          },
          {
            "name": "provider_error_observed",
            "actionId": "com.datadoghq.core.echo",
            "display": {
              "bounds": {
                "x": 0,
                "y": 552
              }
            },
            "parameters": [
              {
                "name": "value",
                "value": "W10 | PROVIDER_ERROR | Confirm application action ledger shows deterministic fallback/HOLD; capture trace/error and provider status. Do not retry blindly or execute an AI irrigation recommendation."
              }
            ],
            "outboundEdges": [
              {
                "branchName": "main",
                "nextStepName": "notify_smiot_app"
              }
            ]
          },
          {
            "name": "latency_degraded",
            "actionId": "com.datadoghq.core.echo",
            "display": {
              "bounds": {
                "x": 384,
                "y": 552
              }
            },
            "parameters": [
              {
                "name": "value",
                "value": "W10 | AI_LATENCY_HIGH | Confirm request trace, timeout behavior and app fallback/HOLD in the action ledger. Keep decisions on deterministic rules or human review; no actuator command."
              }
            ],
            "outboundEdges": [
              {
                "branchName": "main",
                "nextStepName": "notify_smiot_app"
              }
            ]
          },
          {
            "name": "no_ai_breach",
            "actionId": "com.datadoghq.core.echo",
            "display": {
              "bounds": {
                "x": 768,
                "y": 552
              }
            },
            "parameters": [
              {
                "name": "value",
                "value": "W10 | PROVIDER_RECOVERED | A fresh provider-success signal is present with no provider failure in the query window. Keep the decision on the validated application path; this workflow does not authorize actuator control."
              }
            ],
            "outboundEdges": [
              {
                "branchName": "main",
                "nextStepName": "notify_smiot_app"
              }
            ]
          },
          {
            "name": "notify_smiot_app",
            "actionId": "com.datadoghq.http.request",
            "connectionLabel": "SMIOT_APP_HTTP",
            "parameters": [
              {
                "name": "verb",
                "value": "POST"
              },
              {
                "name": "url",
                "value": "https://13-238-30-218.sslip.io/api/integrations/datadog/notification"
              },
              {
                "name": "requestHeaders",
                "value": [
                  {
                    "key": "Content-Type",
                    "value": [
                      "application/json"
                    ]
                  }
                ]
              },
              {
                "name": "body",
                "value": "{\"event_id\":\"{{InstanceId}}\",\"workflow_name\":\"{{WorkflowName}}\",\"workflow_id\":\"{{WorkflowId}}\",\"message\":\"W10 AI provider safety review completed. Provider errors or latency keep the application in a safe HOLD path; no unverified AI decision was used. Run {{InstanceId}} contains the evidence. Correlation remains unverified: this workflow context does not supply a verified incident, farm, or scenario-run ID.\",\"category\":\"datadog\",\"severity\":\"warning\",\"workflow_run_id\":\"{{InstanceId}}\",\"status\":\"investigating\",\"verification_status\":\"unknown\"}"
              }
            ],
            "readinessGate": {
              "thresholdType": "ANY"
            }
          }
        ],
        "handle": "smiot-w10-ai-failure-safety",
        "triggers": [
          {
            "startStepNames": [
              "read_operational_signals"
            ],
            "monitorTrigger": {
              "rateLimit": {
                "count": 1,
                "interval": "300s"
              }
            }
          },
          {
            "startStepNames": [
              "read_operational_signals"
            ],
            "apiTrigger": {}
          }
        ],
        "connectionEnvs": [
          {
            "env": "default",
            "connections": [
              {
                "connectionId": "0e1ab54b-a758-47ad-ab39-c9ab4e091dba",
                "label": "SMIOT_APP_HTTP"
              }
            ]
          }
        ]
      }
    }
  }
}
