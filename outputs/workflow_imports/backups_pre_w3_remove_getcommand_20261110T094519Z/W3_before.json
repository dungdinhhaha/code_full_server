{
  "data": {
    "id": "373ed0c0-4509-4fcd-a067-f54f0becc00e",
    "type": "workflows",
    "attributes": {
      "createdAt": "2026-11-09T16:32:10.679053Z",
      "description": "Starts only the SMIOT web application after the inactive-service monitor fires. SSM checks MongoDB, MQTT, disk, deduplication, HTTP health, and fresh MongoDB telemetry; it never restarts MongoDB or MQTT.",
      "name": "SMIOT | Guarded EC2 app recovery",
      "published": true,
      "runAsUserMode": "owner",
      "sensitivePrivileges": false,
      "spec": {
        "triggers": [
          {
            "startStepNames": [
              "Send_command"
            ],
            "monitorTrigger": {
              "rateLimit": {
                "count": 1,
                "interval": "600s"
              }
            }
          },
          {
            "startStepNames": [
              "Send_command"
            ],
            "apiTrigger": {}
          }
        ],
        "steps": [
          {
            "name": "Send_command",
            "actionId": "com.datadoghq.aws.system_manager.sendCommand",
            "connectionLabel": "INTEGRATION_AWS",
            "parameters": [
              {
                "name": "region",
                "value": "ap-southeast-2"
              },
              {
                "name": "documentName",
                "value": "SMIOT-GuardedStartApp"
              },
              {
                "name": "instanceIds",
                "value": [
                  "i-00bf2d3591d3ee0a2"
                ]
              },
              {
                "name": "parameters",
                "value": {
                  "DryRun": [
                    "false"
                  ],
                  "IncidentId": [
                    "{{ InstanceId }}"
                  ]
                }
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "notify_smiot_app",
                "branchName": "main"
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 192
              }
            }
          },
          {
            "name": "notify_smiot_app",
            "actionId": "com.datadoghq.http.request",
            "connectionLabel": "SMIOT_APP_HTTP",
            "parameters": [
              {
                "name": "verb",
                "value": "POST"
              },
              {
                "name": "url",
                "value": "https://13-238-30-218.sslip.io/api/integrations/datadog/notification"
              },
              {
                "name": "requestHeaders",
                "value": [
                  {
                    "key": "Content-Type",
                    "value": [
                      "application/json"
                    ]
                  }
                ]
              },
              {
                "name": "body",
                "value": "{\"event_id\":\"{{InstanceId}}-action-started\",\"workflow_name\":\"{{WorkflowName}}\",\"workflow_id\":\"{{WorkflowId}}\",\"workflow_run_id\":\"{{InstanceId}}\",\"monitor_id\":\"{{Source.monitor.id}}\",\"message\":\"Guarded SMIOT app recovery started. The app is checking database and broker guards before starting only the web service.\",\"category\":\"datadog\",\"severity\":\"warning\",\"status\":\"action_started\",\"action_code\":\"guarded_app_start\",\"verification_status\":\"pending\"}"
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "Get_command",
                "branchName": "main"
              }
            ],
            "display": {
              "bounds": {
                "x": 180,
                "y": 192
              }
            }
          },
          {
            "name": "Get_command",
            "actionId": "com.datadoghq.aws.system_manager.getCommand",
            "connectionLabel": "INTEGRATION_AWS",
            "parameters": [
              {
                "name": "region",
                "value": "ap-southeast-2"
              },
              {
                "name": "commandId",
                "value": "{{ Steps.Send_command.command.CommandId }}"
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "verify_smiot_recovery",
                "branchName": "main"
              }
            ],
            "errorHandlers": [
              {
                "retryStrategy": {
                  "kind": "RETRY_STRATEGY_LINEAR",
                  "linear": {
                    "interval": "1s",
                    "maxRetries": 0
                  }
                },
                "fallbackStepName": "verify_smiot_recovery"
              }
            ],
            "completionGate": {
              "completionCondition": {
                "operand1": "{{ Steps.Get_command.command.Status }}",
                "operator": "OPERATOR_EQUAL",
                "operand2": "Success"
              },
              "retryStrategy": {
                "kind": "RETRY_STRATEGY_LINEAR",
                "linear": {
                  "interval": "15s",
                  "maxRetries": 6
                }
              }
            },
            "display": {
              "bounds": {
                "x": 360,
                "y": 120
              }
            }
          },
          {
            "name": "verify_smiot_recovery",
            "actionId": "com.datadoghq.http.request",
            "connectionLabel": "SMIOT_APP_HTTP",
            "parameters": [
              {
                "name": "verb",
                "value": "POST"
              },
              {
                "name": "url",
                "value": "https://13-238-30-218.sslip.io/api/integrations/datadog/recovery-verification"
              },
              {
                "name": "requestHeaders",
                "value": [
                  {
                    "key": "Content-Type",
                    "value": [
                      "application/json"
                    ]
                  }
                ]
              },
              {
                "name": "body",
                "value": "{\"workflow_run_id\":\"{{InstanceId}}\",\"instance_id\":\"i-00bf2d3591d3ee0a2\"}"
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "classify_smiot_recovery",
                "branchName": "main"
              }
            ],
            "readinessGate": {
              "thresholdType": "ANY"
            },
            "errorHandlers": [
              {
                "retryStrategy": {
                  "kind": "RETRY_STRATEGY_LINEAR",
                  "linear": {
                    "interval": "1s",
                    "maxRetries": 0
                  }
                },
                "fallbackStepName": "notify_recovery_unverified_smiot_app"
              }
            ],
            "display": {
              "bounds": {
                "x": 360,
                "y": 192
              }
            }
          },
          {
            "name": "classify_smiot_recovery",
            "actionId": "com.datadoghq.core.if",
            "parameters": [
              {
                "name": "joinOperator",
                "value": "and"
              },
              {
                "name": "conditions",
                "value": [
                  {
                    "comparisonOperator": "eq",
                    "leftValue": "${ (() => { try { const h=Steps.verify_smiot_recovery||{}; const raw=h.body??h.response?.body??h.data?.body??h.responseBody; const b=typeof raw===\"string\"?JSON.parse(raw):raw; const code=Number(h.statusCode??h.status??h.httpStatusCode??h.response?.statusCode??h.response?.status); return code===200 && b?.verified===true && [\"recovered\",\"already_healthy\"].includes(b?.status); } catch (_) { return false; } })() }",
                    "rightValue": true
                  }
                ]
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "classify_smiot_guard_outcome",
                "branchName": "true"
              },
              {
                "nextStepName": "notify_recovery_unverified_smiot_app",
                "branchName": "false"
              }
            ],
            "errorHandlers": [
              {
                "retryStrategy": {
                  "kind": "RETRY_STRATEGY_LINEAR",
                  "linear": {
                    "interval": "1s",
                    "maxRetries": 0
                  }
                },
                "fallbackStepName": "notify_recovery_unverified_smiot_app"
              }
            ],
            "display": {
              "bounds": {
                "x": 720,
                "y": 120
              }
            }
          },
          {
            "name": "classify_smiot_guard_outcome",
            "actionId": "com.datadoghq.core.if",
            "parameters": [
              {
                "name": "joinOperator",
                "value": "and"
              },
              {
                "name": "conditions",
                "value": [
                  {
                    "comparisonOperator": "eq",
                    "leftValue": "${ (() => { try { const h=Steps.verify_smiot_recovery||{}; const raw=h.body??h.response?.body??h.data?.body??h.responseBody; const b=typeof raw===\"string\"?JSON.parse(raw):raw; return b?.status===\"already_healthy\"; } catch (_) { return false; } })() }",
                    "rightValue": true
                  }
                ]
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "notify_already_healthy_smiot_app",
                "branchName": "true"
              },
              {
                "nextStepName": "notify_verified_smiot_app",
                "branchName": "false"
              }
            ],
            "display": {
              "bounds": {
                "x": 1080,
                "y": 120
              }
            }
          },
          {
            "name": "notify_verified_smiot_app",
            "actionId": "com.datadoghq.http.request",
            "connectionLabel": "SMIOT_APP_HTTP",
            "parameters": [
              {
                "name": "verb",
                "value": "POST"
              },
              {
                "name": "url",
                "value": "https://13-238-30-218.sslip.io/api/integrations/datadog/notification"
              },
              {
                "name": "requestHeaders",
                "value": [
                  {
                    "key": "Content-Type",
                    "value": [
                      "application/json"
                    ]
                  }
                ]
              },
              {
                "name": "body",
                "value": "{\"severity\":\"info\",\"event_id\":\"{{InstanceId}}-recovery-verified\",\"monitor_id\":\"{{Source.monitor.id}}\",\"category\":\"datadog\",\"evidence_refs\":[\"{{InstanceId}}\"],\"verification_status\":\"passed\",\"message\":\"Guarded app recovery completed. The verifier confirmed healthy app, MongoDB, MQTT, and fresh persisted telemetry for this workflow run.\",\"workflow_id\":\"{{WorkflowId}}\",\"workflow_name\":\"{{WorkflowName}}\",\"action_code\":\"guarded_app_recovery\",\"workflow_run_id\":\"{{InstanceId}}\",\"status\":\"recovered\"}"
              }
            ],
            "display": {
              "bounds": {
                "x": 540,
                "y": 192
              }
            }
          },
          {
            "name": "notify_already_healthy_smiot_app",
            "actionId": "com.datadoghq.http.request",
            "connectionLabel": "SMIOT_APP_HTTP",
            "parameters": [
              {
                "name": "verb",
                "value": "POST"
              },
              {
                "name": "url",
                "value": "https://13-238-30-218.sslip.io/api/integrations/datadog/notification"
              },
              {
                "name": "requestHeaders",
                "value": [
                  {
                    "key": "Content-Type",
                    "value": [
                      "application/json"
                    ]
                  }
                ]
              },
              {
                "name": "body",
                "value": "{\"severity\":\"info\",\"event_id\":\"{{InstanceId}}-already-healthy\",\"monitor_id\":\"{{Source.monitor.id}}\",\"category\":\"datadog\",\"evidence_refs\":[\"{{InstanceId}}\"],\"verification_status\":\"passed\",\"message\":\"No restart was needed: the guarded SSM action reported the app already active, and the verifier confirmed app, MongoDB, MQTT, and fresh persisted telemetry are healthy.\",\"workflow_id\":\"{{WorkflowId}}\",\"workflow_name\":\"{{WorkflowName}}\",\"action_code\":\"guarded_start_skipped_healthy\",\"workflow_run_id\":\"{{InstanceId}}\",\"status\":\"already_healthy\"}"
              }
            ],
            "display": {
              "bounds": {
                "x": 1440,
                "y": 0
              }
            }
          },
          {
            "name": "notify_recovery_unverified_smiot_app",
            "actionId": "com.datadoghq.http.request",
            "connectionLabel": "SMIOT_APP_HTTP",
            "parameters": [
              {
                "name": "verb",
                "value": "POST"
              },
              {
                "name": "url",
                "value": "https://13-238-30-218.sslip.io/api/integrations/datadog/notification"
              },
              {
                "name": "requestHeaders",
                "value": [
                  {
                    "key": "Content-Type",
                    "value": [
                      "application/json"
                    ]
                  }
                ]
              },
              {
                "name": "body",
                "value": "{\"severity\":\"warning\",\"event_id\":\"{{InstanceId}}-recovery-unverified\",\"monitor_id\":\"{{Source.monitor.id}}\",\"category\":\"datadog\",\"evidence_refs\":[\"{{InstanceId}}\"],\"verification_status\":\"pending\",\"message\":\"Recovery is not confirmed. Keep the incident open; inspect the SSM command and verifier result. The workflow has not marked the service recovered.\",\"workflow_id\":\"{{WorkflowId}}\",\"workflow_name\":\"{{WorkflowName}}\",\"action_code\":\"guarded_app_recovery_unverified\",\"workflow_run_id\":\"{{InstanceId}}\",\"status\":\"pending_verification\"}"
              }
            ],
            "readinessGate": {
              "thresholdType": "ANY"
            },
            "display": {
              "bounds": {
                "x": 1440,
                "y": 240
              }
            }
          }
        ],
        "handle": "smiot-guarded-ec2-recovery",
        "connectionEnvs": [
          {
            "env": "default",
            "connections": [
              {
                "connectionId": "9477b5cd-189f-442b-aa16-f2b76089efc8",
                "label": "INTEGRATION_AWS"
              },
              {
                "connectionId": "0e1ab54b-a758-47ad-ab39-c9ab4e091dba",
                "label": "SMIOT_APP_HTTP"
              }
            ]
          }
        ]
      },
      "tags": [
        "env:demo",
        "project:smiot",
        "service:smiot-smart-farm"
      ],
      "updatedAt": "2026-11-10T09:44:20.390324Z"
    },
