{
  "data": {
    "id": "ffd62026-6b63-40e4-9b46-6ac18d2d584f",
    "type": "workflows",
    "attributes": {
      "createdAt": "2026-11-09T17:31:06.191325Z",
      "description": "Read-only guard for the Ca 1 status-mismatch monitor. Confirms the mismatch is still present and checks farm-wide data freshness. It never restarts the app or any device.",
      "name": "SMIOT | Ca 1 | Refuse restart when samples are fresh",
      "published": true,
      "runAsUserMode": "owner",
      "sensitivePrivileges": false,
      "spec": {
        "triggers": [
          {
            "startStepNames": [
              "query_freshness_both_sources"
            ],
            "monitorTrigger": {
              "rateLimit": {
                "count": 1,
                "interval": "300s"
              }
            }
          }
        ],
        "steps": [
          {
            "name": "query_freshness_both_sources",
            "actionId": "com.datadoghq.dd.metrics.queryScalarData",
            "parameters": [
              {
                "name": "range",
                "value": "3m"
              },
              {
                "name": "queries",
                "value": [
                  {
                    "aggregator": "last",
                    "data_source": "metrics",
                    "name": "status_mismatch",
                    "query": "max:smiot.telemetry.status_mismatch{farm:greenhouse_a,node:1}"
                  },
                  {
                    "aggregator": "last",
                    "data_source": "metrics",
                    "name": "mongo_sample_age_s",
                    "query": "max:smiot.telemetry.sample_age_seconds{farm:greenhouse_a,node:1}"
                  }
                ]
              },
              {
                "name": "formulas",
                "value": [
                  {
                    "formula": "status_mismatch"
                  },
                  {
                    "formula": "mongo_sample_age_s"
                  }
                ]
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "verify_evidence_available",
                "branchName": "main"
              }
            ],
            "errorHandlers": [
              {
                "retryStrategy": {
                  "kind": "RETRY_STRATEGY_LINEAR",
                  "linear": {
                    "interval": "1s",
                    "maxRetries": 1
                  }
                },
                "fallbackStepName": "escalate_query_failed"
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 96
              }
            }
          },
          {
            "name": "verify_evidence_available",
            "actionId": "com.datadoghq.core.if",
            "parameters": [
              {
                "name": "joinOperator",
                "value": "and"
              },
              {
                "name": "conditions",
                "value": [
                  {
                    "comparisonOperator": "eq",
                    "leftValue": "${ (() => { const c=Steps.query_freshness_both_sources.data?.attributes?.columns || []; const names=[\"status_mismatch\", \"mongo_sample_age_s\"]; return names.every(k => { const v=Number(c.find(x=>x.name===k)?.values?.[0]); return Number.isFinite(v); }); })() }",
                    "rightValue": true
                  }
                ]
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "classify_freshness",
                "branchName": "true"
              },
              {
                "nextStepName": "escalate_missing_evidence",
                "branchName": "false"
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 216
              }
            }
          },
          {
            "name": "classify_freshness",
            "actionId": "com.datadoghq.core.if",
            "parameters": [
              {
                "name": "joinOperator",
                "value": "and"
              },
              {
                "name": "conditions",
                "value": [
                  {
                    "comparisonOperator": "eq",
                    "leftValue": "${ (() => { const cols = Steps.query_freshness_both_sources.data?.attributes?.columns || []; const mismatch = Number(cols.find(c => c.name === \"status_mismatch\")?.values?.[0]); const age = Number(cols.find(c => c.name === \"mongo_sample_age_s\")?.values?.[0]); const threshold = Number(Trigger.threshold_seconds); return mismatch > 0 && Number.isFinite(age) && Number.isFinite(threshold) && threshold > 0 && age >= 0 && age < threshold; })() }",
                    "rightValue": true
                  }
                ]
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "refuse_restart_fresh_samples",
                "branchName": "true"
              },
              {
                "nextStepName": "escalate_not_confirmed_fresh",
                "branchName": "false"
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 384
              }
            }
          },
          {
            "name": "refuse_restart_fresh_samples",
            "actionId": "com.datadoghq.core.echo",
            "parameters": [
              {
                "name": "value",
                "value": "CA1 | REFUSED_RESTART | current node 1 status_mismatch=1 and MongoDB sample age is below the 90-second stale threshold | monitor 342585836 is the trigger | no app/device action; investigate UI state/cache and preserve incoming samples | RECORD=workflow run and linked monitor event | VERIFY=check app action ledger and fresh telemetry before marking recovered; Echo is not recovery proof"
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "notify_smiot_app",
                "branchName": "main"
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 552
              }
            }
          },
          {
            "name": "escalate_not_confirmed_fresh",
            "actionId": "com.datadoghq.core.echo",
            "parameters": [
              {
                "name": "value",
                "value": "CA1 | ESCALATE_HUMAN | node 1 mismatch is no longer current, MongoDB freshness is missing/stale, or freshness could not be proven | fail closed; inspect the monitor group and app logs; no restart/action | DECISION=UNKNOWN_OR_NO_TRIGGER | ACTION=NONE | NEXT=operator review; retain uncertainty"
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "notify_smiot_app",
                "branchName": "main"
              }
            ],
            "display": {
              "bounds": {
                "x": 384,
                "y": 552
              }
            }
          },
          {
            "name": "escalate_query_failed",
            "actionId": "com.datadoghq.core.echo",
            "parameters": [
              {
                "name": "value",
                "value": "ESCALATE_HUMAN | CA1 | freshness metric query failed | action=none | never restart on missing evidence | DECISION=UNKNOWN_OR_NO_TRIGGER | ACTION=NONE | NEXT=operator review; retain uncertainty"
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "notify_smiot_app",
                "branchName": "main"
              }
            ],
            "display": {
              "bounds": {
                "x": 384,
                "y": 552
              }
            }
          },
          {
            "name": "escalate_missing_evidence",
            "actionId": "com.datadoghq.core.echo",
            "parameters": [
              {
                "name": "value",
                "value": "W4 | DECISION=UNKNOWN | EVIDENCE=required metric column missing or non-numeric | ACTION=NONE | NEXT=operator checks telemetry source and monitor window; do not mark recovered"
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "notify_smiot_app",
                "branchName": "main"
              }
            ],
            "display": {
              "bounds": {
                "x": 384,
                "y": 552
              }
            }
          },
          {
            "name": "notify_smiot_app",
            "actionId": "com.datadoghq.http.request",
            "connectionLabel": "SMIOT_APP_HTTP",
            "parameters": [
              {
                "name": "verb",
                "value": "POST"
              },
              {
                "name": "url",
                "value": "https://13-238-30-218.sslip.io/api/integrations/datadog/notification"
              },
              {
                "name": "requestHeaders",
                "value": [
                  {
                    "key": "Content-Type",
                    "value": [
                      "application/json"
                    ]
                  }
                ]
              },
              {
                "name": "body",
                "value": "{\"event_id\":\"{{InstanceId}}\",\"workflow_name\":\"{{WorkflowName}}\",\"workflow_id\":\"{{WorkflowId}}\",\"message\":\"Datadog ran workflow {{WorkflowName}}. Open run {{InstanceId}} to review the result and next step.\",\"category\":\"datadog\",\"severity\":\"info\"}"
              }
            ],
            "readinessGate": {
              "thresholdType": "ANY"
            }
          }
        ],
        "handle": "smiot-ca1-refuse-restart-1",
        "connectionEnvs": [
          {
            "env": "default",
            "connections": [
              {
                "connectionId": "0e1ab54b-a758-47ad-ab39-c9ab4e091dba",
                "label": "SMIOT_APP_HTTP"
              }
            ]
          }
        ],
        "inputSchema": {
          "parameters": [
            {
              "name": "threshold_seconds",
              "type": "NUMBER",
              "defaultValue": 90
            }
          ]
        }
      },
      "tags": [
        "case:ca1",
        "env:demo",
        "project:smiot",
        "safety:no-restart",
        "service:smiot-smart-farm"
      ],
      "updatedAt": "2026-11-10T08:05:56.645863Z"
    },
    "relationships": {
      "creator": {
        "data": {
          "id": "92c5d45e-0b70-4b11-92d4-6cec4993965b",
          "type": "users"
        }
      },
      "owner": {
        "data": {
          "id": "92c5d45e-0b70-4b11-92d4-6cec4993965b",
          "type": "users"
        }
      }
    }
  }
}
