{
  "data": {
    "id": "593a670c-d59c-4104-8658-df260245a21e",
    "type": "workflows",
    "attributes": {
      "createdAt": "2026-11-09T18:11:15.083488Z",
      "description": "Reads VPD and soil EC evidence for crop-risk triage. No unapproved thresholds, pollination inference, pesticide advice, or automatic ventilation/drainage action.",
      "name": "SMIOT | W8 | Crop climate and EC evidence review",
      "published": true,
      "runAsUserMode": "owner",
      "sensitivePrivileges": false,
      "spec": {
        "triggers": [
          {
            "startStepNames": [
              "read_operational_signals"
            ],
            "monitorTrigger": {
              "rateLimit": {
                "count": 1,
                "interval": "300s"
              }
            }
          }
        ],
        "steps": [
          {
            "name": "read_operational_signals",
            "actionId": "com.datadoghq.dd.metrics.queryScalarData",
            "parameters": [
              {
                "name": "range",
                "value": "10m"
              },
              {
                "name": "queries",
                "value": [
                  {
                    "aggregator": "last",
                    "data_source": "metrics",
                    "name": "vpd_kpa",
                    "query": "avg:smiot.crop.vpd_kpa{*}"
                  },
                  {
                    "aggregator": "last",
                    "data_source": "metrics",
                    "name": "soil_ec",
                    "query": "avg:smiot.telemetry.soil_ec{*}"
                  }
                ]
              },
              {
                "name": "formulas",
                "value": [
                  {
                    "formula": "vpd_kpa"
                  },
                  {
                    "formula": "soil_ec"
                  }
                ]
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "classify_evidence",
                "branchName": "main"
              }
            ],
            "errorHandlers": [
              {
                "retryStrategy": {
                  "kind": "RETRY_STRATEGY_LINEAR",
                  "linear": {
                    "interval": "1s",
                    "maxRetries": 1
                  }
                },
                "fallbackStepName": "escalate_query_failed"
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 96
              }
            }
          },
          {
            "name": "classify_evidence",
            "actionId": "com.datadoghq.core.if",
            "parameters": [
              {
                "name": "joinOperator",
                "value": "and"
              },
              {
                "name": "conditions",
                "value": [
                  {
                    "comparisonOperator": "eq",
                    "leftValue": "${ (() => { const c=Steps.read_operational_signals.data?.attributes?.columns || []; const v=Number(c.find(x=>x.name===\"vpd_kpa\")?.values?.[0]); const e=Number(c.find(x=>x.name===\"soil_ec\")?.values?.[0]); return Number.isFinite(v) || Number.isFinite(e); })() }",
                    "rightValue": true
                  }
                ]
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "evidence_observed",
                "branchName": "true"
              },
              {
                "nextStepName": "escalate_or_review",
                "branchName": "false"
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 264
              }
            }
          },
          {
            "name": "evidence_observed",
            "actionId": "com.datadoghq.core.echo",
            "parameters": [
              {
                "name": "value",
                "value": "W8 | CROP_INPUTS_AVAILABLE | VPD/EC evidence was returned. Compare against an agronomist-approved crop-stage envelope and route pollination/disease observations to a person. No fan, drainage or spray command."
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 432
              }
            }
          },
          {
            "name": "escalate_or_review",
            "actionId": "com.datadoghq.core.echo",
            "parameters": [
              {
                "name": "value",
                "value": "W8 | CROP_RISK_UNKNOWN | VPD and EC evidence is missing. Treat crop risk as unknown, repair telemetry, and ask a person to inspect; no automatic climate action."
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 432
              }
            }
          },
          {
            "name": "escalate_query_failed",
            "actionId": "com.datadoghq.core.echo",
            "parameters": [
              {
                "name": "value",
                "value": "SMIOT | W8 | Crop climate and EC evidence review | QUERY_FAILED | Evidence unavailable; fail closed and hand to an operator. No actuator or infrastructure action."
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 96
              }
            }
          }
        ],
        "handle": "smiot-w08-crop-risk-review"
      },
      "tags": [
        "env:demo",
        "plan:workflow-08",
        "project:smiot",
        "safety:read-only",
        "service:smiot-smart-farm"
      ],
      "updatedAt": "2026-11-09T18:11:15.89465Z"
    },
