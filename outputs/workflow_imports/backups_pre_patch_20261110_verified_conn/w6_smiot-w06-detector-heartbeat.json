{
  "data": {
    "id": "d8e1b3db-1a54-4b4f-9be3-bf7e270a86f3",
    "type": "workflows",
    "attributes": {
      "createdAt": "2026-11-09T18:11:13.272334Z",
      "description": "Read-only check of the detector heartbeat signal. Missing metric is treated as unknown and escalated; workflow does not restart processes.",
      "name": "SMIOT | W6 | Detector heartbeat review",
      "published": true,
      "runAsUserMode": "owner",
      "sensitivePrivileges": false,
      "spec": {
        "triggers": [
          {
            "startStepNames": [
              "read_operational_signals"
            ],
            "monitorTrigger": {
              "rateLimit": {
                "count": 1,
                "interval": "300s"
              }
            }
          }
        ],
        "steps": [
          {
            "name": "read_operational_signals",
            "actionId": "com.datadoghq.dd.metrics.queryScalarData",
            "parameters": [
              {
                "name": "range",
                "value": "10m"
              },
              {
                "name": "queries",
                "value": [
                  {
                    "aggregator": "last",
                    "data_source": "metrics",
                    "name": "heartbeat",
                    "query": "max:smiot.detector.heartbeat{*}"
                  }
                ]
              },
              {
                "name": "formulas",
                "value": [
                  {
                    "formula": "heartbeat"
                  }
                ]
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "classify_evidence",
                "branchName": "main"
              }
            ],
            "errorHandlers": [
              {
                "retryStrategy": {
                  "kind": "RETRY_STRATEGY_LINEAR",
                  "linear": {
                    "interval": "1s",
                    "maxRetries": 1
                  }
                },
                "fallbackStepName": "escalate_query_failed"
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 96
              }
            }
          },
          {
            "name": "classify_evidence",
            "actionId": "com.datadoghq.core.if",
            "parameters": [
              {
                "name": "joinOperator",
                "value": "and"
              },
              {
                "name": "conditions",
                "value": [
                  {
                    "comparisonOperator": "eq",
                    "leftValue": "${ (() => { const c=Steps.read_operational_signals.data?.attributes?.columns || []; const v=Number(c.find(x=>x.name===\"heartbeat\")?.values?.[0]); return Number.isFinite(v) && v>0; })() }",
                    "rightValue": true
                  }
                ]
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "evidence_observed",
                "branchName": "true"
              },
              {
                "nextStepName": "escalate_or_review",
                "branchName": "false"
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 264
              }
            }
          },
          {
            "name": "evidence_observed",
            "actionId": "com.datadoghq.core.echo",
            "parameters": [
              {
                "name": "value",
                "value": "W6 | HEARTBEAT_SEEN | Detector reported a heartbeat in the query window. Verify latest persisted finding and detector logs; no process action."
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 432
              }
            }
          },
          {
            "name": "escalate_or_review",
            "actionId": "com.datadoghq.core.echo",
            "parameters": [
              {
                "name": "value",
                "value": "W6 | HEARTBEAT_MISSING_OR_UNKNOWN | No heartbeat value was returned. Confirm metric ingestion and app health, then escalate. Do not restart from missing evidence."
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 432
              }
            }
          },
          {
            "name": "escalate_query_failed",
            "actionId": "com.datadoghq.core.echo",
            "parameters": [
              {
                "name": "value",
                "value": "SMIOT | W6 | Detector heartbeat review | QUERY_FAILED | Evidence unavailable; fail closed and hand to an operator. No actuator or infrastructure action."
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 96
              }
            }
          }
        ],
        "handle": "smiot-w06-detector-heartbeat"
      },
      "tags": [
        "env:demo",
        "plan:workflow-06",
        "project:smiot",
        "safety:read-only",
        "service:smiot-smart-farm"
      ],
      "updatedAt": "2026-11-09T18:11:14.597383Z"
    },
    "relationships": {
      "creator": {
        "data": {
          "id": "92c5d45e-0b70-4b11-92d4-6cec4993965b",
          "type": "users"
        }
      },
      "owner": {
        "data": {
          "id": "92c5d45e-0b70-4b11-92d4-6cec4993965b",
          "type": "users"
        }
      }
    }
  }
}
