                 "attributes":  {
                                    "createdAt":  "2026-11-09T17:32:13.148318Z",
                                    "description":  "Read-only workflow for the soil humidity flatline monitor. It confirms the backend flatline signal only. App/virtual PLC HOLD acknowledgement must be verified from the app action ledger; this workflow never sends HOLD/CLEAR or actuator commands.",
                                    "name":  "SMIOT | Ca 2 | Confirm local interlock",
                                    "published":  true,
                                    "runAsUserMode":  "owner",
                                    "sensitivePrivileges":  false,
                                    "spec":  {
                                                 "triggers":  [
                                                                  {
                                                                      "startStepNames":  [
                                                                                             "query_flatline_and_interlock"
                                                                                         ],
                                                                      "monitorTrigger":  {
                                                                                             "rateLimit":  {
                                                                                                               "count":  1,
                                                                                                               "interval":  "300s"
                                                                                                           }
                                                                                         }
                                                                  },
                                                                  {
                                                                      "startStepNames":  [
                                                                                             "query_flatline_and_interlock"
                                                                                         ],
                                                                      "apiTrigger":  {

                                                                                     }
                                                                  }
                                                              ],
                                                 "steps":  [
                                                               {
                                                                   "name":  "query_flatline_and_interlock",
                                                                   "actionId":  "com.datadoghq.dd.metrics.queryScalarData",
                                                                   "parameters":  [
                                                                                      {
                                                                                          "name":  "range",
                                                                                          "value":  "5m"
                                                                                      },
                                                                                      {
                                                                                          "name":  "queries",
                                                                                          "value":  [
                                                                                                        {
                                                                                                            "aggregator":  "last",
                                                                                                            "data_source":  "metrics",
                                                                                                            "name":  "flatline",
                                                                                                            "query":  "max:smiot.telemetry.sensor_flatline{farm:greenhouse_a,node:2}"
                                                                                                        }
                                                                                                    ]
                                                                                      },
                                                                                      {
                                                                                          "name":  "formulas",
                                                                                          "value":  [
                                                                                                        {
                                                                                                            "formula":  "flatline"
                                                                                                        }
                                                                                                    ]
                                                                                      }
                                                                                  ],
                                                                   "outboundEdges":  [
                                                                                         {
                                                                                             "nextStepName":  "verify_evidence_available",
                                                                                             "branchName":  "main"
                                                                                         }
                                                                                     ],
                                                                   "errorHandlers":  [
                                                                                         {
                                                                                             "retryStrategy":  {
                                                                                                                   "kind":  "RETRY_STRATEGY_LINEAR",
                                                                                                                   "linear":  {
                                                                                                                                  "interval":  "1s",
                                                                                                                                  "maxRetries":  1
                                                                                                                              }
                                                                                                               },
                                                                                             "fallbackStepName":  "Echo_query_failed"
                                                                                         }
                                                                                     ],
                                                                   "display":  {
                                                                                   "bounds":  {
                                                                                                  "x":  0,
                                                                                                  "y":  96
                                                                                              }
                                                                               }
                                                               },
                                                               {
                                                                   "name":  "verify_evidence_available",
                                                                   "actionId":  "com.datadoghq.core.if",
                                                                   "parameters":  [
                                                                                      {
                                                                                          "name":  "joinOperator",
                                                                                          "value":  "and"
                                                                                      },
                                                                                      {
                                                                                          "name":  "conditions",
                                                                                          "value":  [
                                                                                                        {
                                                                                                            "comparisonOperator":  "eq",
                                                                                                            "leftValue":  "${ (() =\u003e { const c=Steps.query_flatline_and_interlock.data?.attributes?.columns || []; const names=[\"flatline\"]; return names.every(k =\u003e { const v=Number(c.find(x=\u003ex.name===k)?.values?.[0]); return Number.isFinite(v); }); })() }",
                                                                                                            "rightValue":  true
                                                                                                        }
                                                                                                    ]
                                                                                      }
                                                                                  ],
                                                                   "outboundEdges":  [
                                                                                         {
                                                                                             "nextStepName":  "If_local_interlock_confirmed",
                                                                                             "branchName":  "true"
                                                                                         },
                                                                                         {
                                                                                             "nextStepName":  "escalate_missing_evidence",
                                                                                             "branchName":  "false"
                                                                                         }
                                                                                     ],
                                                                   "display":  {
                                                                                   "bounds":  {
                                                                                                  "x":  0,
                                                                                                  "y":  216
                                                                                              }
                                                                               }
                                                               },
                                                               {
                                                                   "name":  "If_local_interlock_confirmed",
                                                                   "actionId":  "com.datadoghq.core.if",
                                                                   "parameters":  [
                                                                                      {
                                                                                          "name":  "joinOperator",
                                                                                          "value":  "and"
                                                                                      },
                                                                                      {
                                                                                          "name":  "conditions",
                                                                                          "value":  [
                                                                                                        {
                                                                                                            "comparisonOperator":  "eq",
                                                                                                            "leftValue":  "${ (() =\u003e { const cols=Steps.query_flatline_and_interlock.data?.attributes?.columns || []; const flatline=Number(cols.find(c=\u003ec.name===\"flatline\")?.values?.[0]); return Number.isFinite(flatline) \u0026\u0026 flatline===1; })() }",
                                                                                                            "rightValue":  true
                                                                                                        }
                                                                                                    ]
                                                                                      }
                                                                                  ],
                                                                   "outboundEdges":  [
                                                                                         {
                                                                                             "nextStepName":  "Echo_local_interlock_confirmed",
                                                                                             "branchName":  "true"
                                                                                         },
                                                                                         {
                                                                                             "nextStepName":  "Echo_escalate_missing_evidence",
                                                                                             "branchName":  "false"
