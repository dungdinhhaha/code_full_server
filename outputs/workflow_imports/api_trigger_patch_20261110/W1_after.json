                                                                                             "rateLimit":  {
                                                                                                               "count":  1,
                                                                                                               "interval":  "300s"
                                                                                                           }
                                                                                         }
                                                                  },
                                                                  {
                                                                      "startStepNames":  [
                                                                                             "read_operational_signals"
