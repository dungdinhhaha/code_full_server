                                                                                      {
                                                                                          "name":  "queries",
                                                                                          "value":  [
                                                                                                        {
                                                                                                            "aggregator":  "last",
                                                                                                            "data_source":  "metrics",
                                                                                                            "name":  "safety_trip",
                                                                                                            "query":  "sum:smiot.virtual_plc.safety_trip{event:safety_trip}"
                                                                                                        }
                                                                                                    ]
                                                                                      },
                                                                                      {
                                                                                          "name":  "formulas",
                                                                                          "value":  [
                                                                                                        {
                                                                                                            "formula":  "safety_trip"
                                                                                                        }
                                                                                                    ]
                                                                                      }
                                                                                  ],
                                                                   "outboundEdges":  [
                                                                                         {
                                                                                             "nextStepName":  "verify_evidence_available",
                                                                                             "branchName":  "main"
                                                                                         }
                                                                                     ],
                                                                   "errorHandlers":  [
                                                                                         {
                                                                                             "retryStrategy":  {
                                                                                                                   "kind":  "RETRY_STRATEGY_LINEAR",
                                                                                                                   "linear":  {
