                                                                   "actionId":  "com.datadoghq.core.if",
                                                                   "parameters":  [
                                                                                      {
                                                                                          "name":  "joinOperator",
                                                                                          "value":  "and"
                                                                                      },
                                                                                      {
                                                                                          "name":  "conditions",
                                                                                          "value":  [
                                                                                                        {
                                                                                                            "comparisonOperator":  "eq",
                                                                                                            "leftValue":  "${ (() =\u003e { const c=Steps.read_operational_signals.data?.attributes?.columns || []; const names=[\"safety_trip\"]; return names.every(k =\u003e { const v=Number(c.find(x=\u003ex.name===k)?.values?.[0]); return Number.isFinite(v); }); })() }",
                                                                                                            "rightValue":  true
                                                                                                        }
