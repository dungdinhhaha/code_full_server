{
  "data": {
    "id": "373ed0c0-4509-4fcd-a067-f54f0becc00e",
    "type": "workflows",
    "attributes": {
      "createdAt": "2026-11-09T16:32:10.679053Z",
      "description": "Starts only the SMIOT web application after the inactive-service monitor fires. SSM checks MongoDB, MQTT, disk, deduplication, HTTP health, and fresh MongoDB telemetry; it never restarts MongoDB or MQTT.",
      "name": "SMIOT | Guarded EC2 app recovery",
      "published": true,
      "runAsUserMode": "owner",
      "sensitivePrivileges": false,
      "spec": {
        "triggers": [
          {
            "startStepNames": [
              "Send_command"
            ],
            "monitorTrigger": {
              "rateLimit": {
                "count": 1,
                "interval": "600s"
              }
            }
          }
        ],
        "steps": [
          {
            "name": "Send_command",
            "actionId": "com.datadoghq.aws.system_manager.sendCommand",
            "connectionLabel": "INTEGRATION_AWS",
            "parameters": [
              {
                "name": "region",
                "value": "ap-southeast-2"
              },
              {
                "name": "documentName",
                "value": "SMIOT-GuardedStartApp"
              },
              {
                "name": "instanceIds",
                "value": [
                  "i-00bf2d3591d3ee0a2"
                ]
              },
              {
                "name": "parameters",
                "value": {
                  "DryRun": [
                    "true"
                  ],
                  "IncidentId": [
                    "{{ InstanceId }}"
                  ]
                }
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "Get_command",
                "branchName": "main"
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 192
              }
            }
          },
          {
            "name": "Get_command",
            "actionId": "com.datadoghq.aws.system_manager.getCommand",
            "connectionLabel": "INTEGRATION_AWS",
            "parameters": [
              {
                "name": "region",
                "value": "ap-southeast-2"
              },
              {
                "name": "commandId",
                "value": "{{ Steps.Send_command.command.CommandId }}"
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "Verify_healthz",
                "branchName": "main"
              }
            ],
            "errorHandlers": [
              {
                "retryStrategy": {
                  "kind": "RETRY_STRATEGY_LINEAR",
                  "linear": {
                    "interval": "1s",
                    "maxRetries": 0
                  }
                },
                "fallbackStepName": "notify_pending"
              }
            ],
            "completionGate": {
              "completionCondition": {
                "operand1": "{{ Steps.Get_command.command.Status }}",
                "operator": "OPERATOR_EQUAL",
                "operand2": "Success"
              },
              "retryStrategy": {
                "kind": "RETRY_STRATEGY_LINEAR",
                "linear": {
                  "interval": "15s",
                  "maxRetries": 6
                }
              }
            }
          },
          {
            "name": "Verify_healthz",
            "actionId": "com.datadoghq.http.request",
            "connectionLabel": "SMIOT_APP_HTTP",
            "parameters": [
              {
                "name": "verb",
                "value": "GET"
              },
              {
                "name": "url",
                "value": "https://13-238-30-218.sslip.io/healthz"
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "Classify_healthz",
                "branchName": "main"
              }
            ],
            "errorHandlers": [
              {
                "retryStrategy": {
                  "kind": "RETRY_STRATEGY_LINEAR",
                  "linear": {
                    "interval": "1s",
                    "maxRetries": 0
                  }
                },
                "fallbackStepName": "notify_pending"
              }
            ]
          },
          {
            "name": "Classify_healthz",
            "actionId": "com.datadoghq.core.if",
            "parameters": [
              {
                "name": "joinOperator",
                "value": "and"
              },
              {
                "name": "conditions",
                "value": [
                  {
                    "comparisonOperator": "eq",
                    "leftValue": "${ (() => { try { const h=Steps.Verify_healthz||{}; const raw=h.body??h.response?.body??h.data?.body??h.responseBody; const b=typeof raw===\"string\"?JSON.parse(raw):raw; const status=Number(h.statusCode??h.status??h.httpStatusCode??h.response?.statusCode??h.response?.status); const age=Number(b?.newest_sample_age_seconds); return status===200 && b?.app===\"ok\" && b?.mongo===\"ok\" && b?.mqtt===\"ok\" && Number.isFinite(age) && age>=0 && age<=180; } catch (_) { return false; } })() }",
                    "rightValue": true
                  }
                ]
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "notify_recovered",
                "branchName": "true"
              },
              {
                "nextStepName": "notify_pending",
                "branchName": "false"
              }
            ],
            "errorHandlers": [
              {
                "retryStrategy": {
                  "kind": "RETRY_STRATEGY_LINEAR",
                  "linear": {
                    "interval": "1s",
                    "maxRetries": 0
                  }
                },
                "fallbackStepName": "notify_pending"
              }
            ]
          },
          {
            "name": "notify_recovered",
            "actionId": "com.datadoghq.http.request",
            "connectionLabel": "SMIOT_APP_HTTP",
            "parameters": [
              {
                "name": "verb",
                "value": "POST"
              },
              {
                "name": "url",
                "value": "https://13-238-30-218.sslip.io/api/integrations/datadog/notification"
              },
              {
                "name": "requestHeaders",
                "value": [
                  {
                    "key": "Content-Type",
                    "value": [
                      "application/json"
                    ]
                  }
                ]
              },
              {
                "name": "body",
                "value": "{\"event_id\":\"{{InstanceId}}\",\"workflow_name\":\"{{WorkflowName}}\",\"workflow_id\":\"{{WorkflowId}}\",\"message\":\"W3 verified: guarded SSM command completed successfully; follow-up /healthz reports app, MongoDB, MQTT healthy and a fresh telemetry sample. Review this workflow run before closing the incident.\",\"category\":\"datadog\",\"severity\":\"info\"}"
              }
            ]
          },
          {
            "name": "notify_pending",
            "actionId": "com.datadoghq.http.request",
            "connectionLabel": "SMIOT_APP_HTTP",
            "parameters": [
              {
                "name": "verb",
                "value": "POST"
              },
              {
                "name": "url",
                "value": "https://13-238-30-218.sslip.io/api/integrations/datadog/notification"
              },
              {
                "name": "requestHeaders",
                "value": [
                  {
                    "key": "Content-Type",
                    "value": [
                      "application/json"
                    ]
                  }
                ]
              },
              {
                "name": "body",
                "value": "{\"event_id\":\"{{InstanceId}}\",\"workflow_name\":\"{{WorkflowName}}\",\"workflow_id\":\"{{WorkflowId}}\",\"message\":\"W3 recovery is not verified. The SSM command did not complete successfully within the bounded wait, /healthz failed, or health data was missing/stale. Keep the incident open and inspect the workflow run.\",\"category\":\"datadog\",\"severity\":\"warning\"}"
              }
            ],
            "readinessGate": {
              "thresholdType": "ANY"
            }
          }
        ],
        "handle": "smiot-guarded-ec2-recovery",
        "connectionEnvs": [
          {
            "env": "default",
            "connections": [
              {
                "connectionId": "9477b5cd-189f-442b-aa16-f2b76089efc8",
                "label": "INTEGRATION_AWS"
              },
              {
                "connectionId": "0e1ab54b-a758-47ad-ab39-c9ab4e091dba",
                "label": "SMIOT_APP_HTTP"
              }
            ]
          }
        ]
      },
      "tags": [
        "env:demo",
        "project:smiot",
        "service:smiot-smart-farm"
      ],
      "updatedAt": "2026-11-10T04:47:38.438299Z"
    },
    "relationships": {
      "creator": {
        "data": {
          "id": "92c5d45e-0b70-4b11-92d4-6cec4993965b",
          "type": "users"
        }
      },
      "owner": {
        "data": {
          "id": "92c5d45e-0b70-4b11-92d4-6cec4993965b",
          "type": "users"
        }
      }
    }
  }
}
