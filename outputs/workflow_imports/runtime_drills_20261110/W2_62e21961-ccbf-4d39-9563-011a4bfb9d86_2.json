          "handle": "smiot-ca2-confirm-local-interlock",
          "steps": [
            {
              "actionId": "com.datadoghq.dd.metrics.queryScalarData",
              "display": {
                "bounds": {
                  "y": 96
                }
              },
              "errorHandlers": [
                {
                  "fallbackStepName": "Echo_query_failed",
                  "retryStrategy": {
                    "kind": "RETRY_STRATEGY_LINEAR",
                    "linear": {
                      "interval": "1s",
                      "maxRetries": 1
                    }
                  }
                }
              ],
              "name": "query_flatline_and_interlock",
              "outboundEdges": [
                {
                  "branchName": "main",
                  "nextStepName": "verify_evidence_available"
                }
              ],
              "parameters": [
                {
                  "name": "range",
                  "value": "5m"
                },
                {
                  "name": "queries",
                  "value": [
                    {
                      "aggregator": "last",
                      "data_source": "metrics",
                      "name": "flatline",
                      "query": "max:smiot.telemetry.sensor_flatline{farm:greenhouse_a,node:2}"
                    }
                  ]
                },
                {
                  "name": "formulas",
                  "value": [
                    {
                      "formula": "flatline"
                    }
                  ]
                }
              ]
            },
            {
              "actionId": "com.datadoghq.core.if",
              "display": {
                "bounds": {
                  "y": 216
                }
              },
              "name": "verify_evidence_available",
              "outboundEdges": [
                {
                  "branchName": "true",
                  "nextStepName": "If_local_interlock_confirmed"
                },
                {
                  "branchName": "false",
                  "nextStepName": "escalate_missing_evidence"
                }
              ],
              "parameters": [
                {
                  "name": "joinOperator",
                  "value": "and"
                },
                {
                  "name": "conditions",
                  "value": [
                    {
                      "comparisonOperator": "eq",
                      "leftValue": "${ (() => { const c=Steps.query_flatline_and_interlock.data?.attributes?.columns || []; const names=[\"flatline\"]; return names.every(k => { const v=Number(c.find(x=>x.name===k)?.values?.[0]); return Number.isFinite(v); }); })() }",
                      "rightValue": true
                    }
                  ]
                }
              ]
            },
            {
              "actionId": "com.datadoghq.core.if",
              "display": {
                "bounds": {
                  "y": 384
                }
              },
              "name": "If_local_interlock_confirmed",
              "outboundEdges": [
                {
                  "branchName": "true",
                  "nextStepName": "Echo_local_interlock_confirmed"
                },
                {
                  "branchName": "false",
                  "nextStepName": "Echo_escalate_missing_evidence"
                }
              ],
              "parameters": [
                {
                  "name": "joinOperator",
                  "value": "and"
                },
                {
                  "name": "conditions",
                  "value": [
                    {
                      "comparisonOperator": "eq",
                      "leftValue": "${ (() => { const cols=Steps.query_flatline_and_interlock.data?.attributes?.columns || []; const flatline=Number(cols.find(c=>c.name===\"flatline\")?.values?.[0]); return Number.isFinite(flatline) && flatline===1; })() }",
                      "rightValue": true
                    }
                  ]
                }
              ]
            },
            {
              "actionId": "com.datadoghq.core.echo",
              "display": {
                "bounds": {
                  "y": 552
                }
              },
              "name": "Echo_local_interlock_confirmed",
