                  "nextStepName": "notify_smiot_app"
                }
              ],
              "parameters": [
                {
                  "name": "value",
                  "value": "W1 | DECISION=UNKNOWN | EVIDENCE=required metric column missing or non-numeric | ACTION=NONE | NEXT=operator checks telemetry source and monitor window; do not mark recovered"
                }
              ]
            },
            {
              "actionId": "com.datadoghq.http.request",
              "connectionLabel": "SMIOT_APP_HTTP",
              "name": "notify_smiot_app",
              "parameters": [
                {
                  "name": "verb",
