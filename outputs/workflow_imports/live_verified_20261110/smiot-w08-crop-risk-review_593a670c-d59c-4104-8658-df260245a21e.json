{
  "data": {
    "id": "593a670c-d59c-4104-8658-df260245a21e",
    "type": "workflows",
    "attributes": {
      "createdAt": "2026-11-09T18:11:15.083488Z",
      "description": "Reads VPD and soil EC evidence for crop-risk triage. No unapproved thresholds, pollination inference, pesticide advice, or automatic ventilation/drainage action.",
      "name": "SMIOT | W8 | Crop climate and EC evidence review",
      "published": true,
      "runAsUserMode": "owner",
      "sensitivePrivileges": false,
      "spec": {
        "triggers": [
          {
            "startStepNames": [
              "read_operational_signals"
            ],
            "monitorTrigger": {
              "rateLimit": {
                "count": 1,
                "interval": "300s"
              }
            }
          }
        ],
        "steps": [
          {
            "name": "read_operational_signals",
            "actionId": "com.datadoghq.dd.metrics.queryScalarData",
            "parameters": [
              {
                "name": "range",
                "value": "10m"
              },
              {
                "name": "queries",
                "value": [
                  {
                    "aggregator": "last",
                    "data_source": "metrics",
                    "name": "vpd_kpa",
                    "query": "avg:smiot.crop.vpd_kpa{*}"
                  },
                  {
                    "aggregator": "last",
                    "data_source": "metrics",
                    "name": "soil_ec",
                    "query": "avg:smiot.telemetry.soil_ec{*}"
                  }
                ]
              },
              {
                "name": "formulas",
                "value": [
                  {
                    "formula": "vpd_kpa"
                  },
                  {
                    "formula": "soil_ec"
                  }
                ]
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "verify_evidence_available",
                "branchName": "main"
              }
            ],
            "errorHandlers": [
              {
                "retryStrategy": {
                  "kind": "RETRY_STRATEGY_LINEAR",
                  "linear": {
                    "interval": "1s",
                    "maxRetries": 1
                  }
                },
                "fallbackStepName": "escalate_query_failed"
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 96
              }
            }
          },
          {
            "name": "verify_evidence_available",
            "actionId": "com.datadoghq.core.if",
            "parameters": [
              {
                "name": "joinOperator",
                "value": "and"
              },
              {
                "name": "conditions",
                "value": [
                  {
                    "comparisonOperator": "eq",
                    "leftValue": "${ (() => { const c=Steps.read_operational_signals.data?.attributes?.columns || []; const names=[\"vpd_kpa\", \"soil_ec\"]; return names.every(k => { const v=Number(c.find(x=>x.name===k)?.values?.[0]); return Number.isFinite(v); }); })() }",
                    "rightValue": true
                  }
                ]
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "classify_evidence",
                "branchName": "true"
              },
              {
                "nextStepName": "escalate_missing_evidence",
                "branchName": "false"
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 216
              }
            }
          },
          {
            "name": "classify_evidence",
            "actionId": "com.datadoghq.core.if",
            "parameters": [
              {
                "name": "joinOperator",
                "value": "and"
              },
              {
                "name": "conditions",
                "value": [
                  {
                    "comparisonOperator": "eq",
                    "leftValue": "${ (() => { const c=Steps.read_operational_signals.data?.attributes?.columns || []; const v=Number(c.find(x=>x.name===\"vpd_kpa\")?.values?.[0]); const e=Number(c.find(x=>x.name===\"soil_ec\")?.values?.[0]); return Number.isFinite(v) || Number.isFinite(e); })() }",
                    "rightValue": true
                  }
                ]
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "evidence_observed",
                "branchName": "true"
              },
              {
                "nextStepName": "escalate_or_review",
                "branchName": "false"
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 384
              }
            }
          },
          {
            "name": "evidence_observed",
            "actionId": "com.datadoghq.core.echo",
            "parameters": [
              {
                "name": "value",
                "value": "W8 | CROP_INPUTS_AVAILABLE | VPD/EC evidence was returned. Compare against an agronomist-approved crop-stage envelope and route pollination/disease observations to a person. No fan, drainage or spray command. | RECORD=workflow run and linked monitor event | VERIFY=check app action ledger and fresh telemetry before marking recovered; Echo is not recovery proof"
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "notify_smiot_app",
                "branchName": "main"
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 552
              }
            }
          },
          {
            "name": "escalate_or_review",
            "actionId": "com.datadoghq.core.echo",
            "parameters": [
              {
                "name": "value",
                "value": "W8 | CROP_RISK_UNKNOWN | VPD and EC evidence is missing. Treat crop risk as unknown, repair telemetry, and ask a person to inspect; no automatic climate action. | DECISION=UNKNOWN_OR_NO_TRIGGER | ACTION=NONE | NEXT=operator review; retain uncertainty"
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "notify_smiot_app",
                "branchName": "main"
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 552
              }
            }
          },
          {
            "name": "escalate_query_failed",
            "actionId": "com.datadoghq.core.echo",
            "parameters": [
              {
                "name": "value",
                "value": "SMIOT | W8 | Crop climate and EC evidence review | DECISION=UNKNOWN | EVIDENCE=QUERY_ERROR | ACTION=NONE | NEXT=OPERATOR | Evidence unavailable; fail closed and hand to an operator. No actuator or infrastructure action."
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "notify_smiot_app",
                "branchName": "main"
              }
            ],
            "display": {
              "bounds": {
                "x": 0,
                "y": 552
              }
            }
          },
          {
            "name": "escalate_missing_evidence",
            "actionId": "com.datadoghq.core.echo",
            "parameters": [
              {
                "name": "value",
                "value": "W8 | DECISION=UNKNOWN | EVIDENCE=required metric column missing or non-numeric | ACTION=NONE | NEXT=operator checks telemetry source and monitor window; do not mark recovered"
              }
            ],
            "outboundEdges": [
              {
                "nextStepName": "notify_smiot_app",
                "branchName": "main"
              }
            ],
            "display": {
              "bounds": {
                "x": 384,
                "y": 552
              }
            }
          },
          {
            "name": "notify_smiot_app",
            "actionId": "com.datadoghq.http.request",
            "connectionLabel": "SMIOT_APP_HTTP",
            "parameters": [
              {
                "name": "verb",
                "value": "POST"
              },
              {
                "name": "url",
                "value": "https://13-238-30-218.sslip.io/api/integrations/datadog/notification"
              },
              {
                "name": "requestHeaders",
                "value": [
                  {
                    "key": "Content-Type",
                    "value": [
                      "application/json"
                    ]
                  }
                ]
              },
              {
                "name": "body",
                "value": "{\"event_id\":\"{{InstanceId}}\",\"workflow_name\":\"{{WorkflowName}}\",\"workflow_id\":\"{{WorkflowId}}\",\"message\":\"Datadog ran workflow {{WorkflowName}}. Open run {{InstanceId}} to review the result and next step.\",\"category\":\"datadog\",\"severity\":\"info\"}"
              }
            ],
            "readinessGate": {
              "thresholdType": "ANY"
            }
          }
        ],
        "handle": "smiot-w08-crop-risk-review",
        "connectionEnvs": [
          {
            "env": "default",
            "connections": [
              {
                "connectionId": "0e1ab54b-a758-47ad-ab39-c9ab4e091dba",
                "label": "SMIOT_APP_HTTP"
              }
            ]
          }
        ]
      },
      "tags": [
        "env:demo",
        "plan:workflow-08",
        "project:smiot",
        "safety:read-only",
        "service:smiot-smart-farm"
      ],
      "updatedAt": "2026-11-10T04:30:32.345018Z"
    },
    "relationships": {
      "creator": {
