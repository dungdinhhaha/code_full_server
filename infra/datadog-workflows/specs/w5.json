{
  "steps": [
    {
      "display": {
        "bounds": {
          "y": 96,
          "x": 0
        }
      },
      "errorHandlers": [
        {
          "fallbackStepName": "escalate_query_failed",
          "retryStrategy": {
            "linear": {
              "interval": "1s",
              "maxRetries": 1
            },
            "kind": "RETRY_STRATEGY_LINEAR"
          }
        }
      ],
      "name": "read_operational_signals",
      "actionId": "com.datadoghq.dd.metrics.queryScalarData",
      "outboundEdges": [
        {
          "branchName": "main",
          "nextStepName": "verify_evidence_available"
        }
      ],
      "parameters": [
        {
          "value": "10m",
          "name": "range"
        },
        {
          "value": [
            {
              "aggregator": "last",
              "name": "mongo_up",
              "query": "min:smiot.dependency.mongo.up{*}",
              "data_source": "metrics"
            },
            {
              "aggregator": "last",
              "name": "mqtt_up",
              "query": "min:smiot.dependency.mqtt.up{*}",
              "data_source": "metrics"
            },
            {
              "aggregator": "last",
              "name": "ingest_lag_ms",
              "query": "max:smiot.telemetry.ingest_lag_ms{*}",
              "data_source": "metrics"
            },
            {
              "aggregator": "last",
              "name": "sample_age_s",
              "query": "max:smiot.telemetry.sample_age_seconds{*}",
              "data_source": "metrics"
            }
          ],
          "name": "queries"
        },
        {
          "value": [
            {
              "formula": "mongo_up"
            },
            {
              "formula": "mqtt_up"
            },
            {
              "formula": "ingest_lag_ms"
            },
            {
              "formula": "sample_age_s"
            }
          ],
          "name": "formulas"
        }
      ]
    },
    {
      "name": "verify_evidence_available",
      "actionId": "com.datadoghq.core.if",
      "display": {
        "bounds": {
          "x": 0,
          "y": 216
        }
      },
      "parameters": [
        {
          "name": "joinOperator",
          "value": "and"
        },
        {
          "name": "conditions",
          "value": [
            {
              "comparisonOperator": "eq",
              "leftValue": "${ (() => { const c=Steps.read_operational_signals.data?.attributes?.columns || []; const names=[\"mongo_up\", \"mqtt_up\", \"ingest_lag_ms\", \"sample_age_s\"]; return names.every(k => { const v=Number(c.find(x=>x.name===k)?.values?.[0]); return Number.isFinite(v); }); })() }",
              "rightValue": true
            }
          ]
        }
      ],
      "outboundEdges": [
        {
          "branchName": "true",
          "nextStepName": "classify_common"
        },
        {
          "branchName": "false",
          "nextStepName": "escalate_missing_evidence"
        }
      ]
    },
    {
      "display": {
        "bounds": {
          "y": 552,
          "x": 0
        }
      },
      "name": "escalate_query_failed",
      "parameters": [
        {
          "value": "SMIOT | W5 | Root cause dependency triage | DECISION=UNKNOWN | EVIDENCE=QUERY_ERROR | ACTION=NONE | NEXT=OPERATOR | Evidence unavailable; fail closed and hand to an operator. No actuator or infrastructure action.",
          "name": "value"
        }
      ],
      "actionId": "com.datadoghq.core.echo",
      "outboundEdges": [
        {
          "branchName": "main",
          "nextStepName": "notify_smiot_app"
        }
      ]
    },
    {
      "name": "escalate_missing_evidence",
      "actionId": "com.datadoghq.core.echo",
      "display": {
        "bounds": {
          "x": 384,
          "y": 552
        }
      },
      "parameters": [
        {
          "name": "value",
          "value": "W5 | DECISION=UNKNOWN | EVIDENCE=required metric column missing or non-numeric | ACTION=NONE | NEXT=operator checks telemetry source and monitor window; do not mark recovered"
        }
      ],
      "outboundEdges": [
        {
          "branchName": "main",
          "nextStepName": "notify_smiot_app"
        }
      ]
    },
    {
      "name": "classify_common",
      "actionId": "com.datadoghq.core.if",
      "display": {
        "bounds": {
          "x": 0,
          "y": 300
        }
      },
      "parameters": [
        {
          "name": "joinOperator",
          "value": "and"
        },
        {
          "name": "conditions",
          "value": [
            {
              "comparisonOperator": "eq",
              "leftValue": "${ (() => { const c=Steps.read_operational_signals.data?.attributes?.columns || []; const m=Number(c.find(x=>x.name===\"mongo_up\")?.values?.[0]); const q=Number(c.find(x=>x.name===\"mqtt_up\")?.values?.[0]); return Number.isFinite(m) && Number.isFinite(q) && m<1 && q<1; })() }",
              "rightValue": true
            }
          ]
        }
      ],
      "outboundEdges": [
        {
          "branchName": "true",
          "nextStepName": "common_dependency_degraded"
        },
        {
          "branchName": "false",
          "nextStepName": "classify_mongo"
        }
      ]
    },
    {
      "name": "classify_mongo",
      "actionId": "com.datadoghq.core.if",
      "display": {
        "bounds": {
          "x": 0,
          "y": 384
        }
      },
      "parameters": [
        {
          "name": "joinOperator",
          "value": "and"
        },
        {
          "name": "conditions",
          "value": [
            {
              "comparisonOperator": "eq",
              "leftValue": "${ (() => { const c=Steps.read_operational_signals.data?.attributes?.columns || []; const v=Number(c.find(x=>x.name===\"mongo_up\")?.values?.[0]); return Number.isFinite(v) && v<1; })() }",
              "rightValue": true
            }
          ]
        }
      ],
      "outboundEdges": [
        {
          "branchName": "true",
          "nextStepName": "mongo_degraded"
        },
        {
          "branchName": "false",
          "nextStepName": "classify_mqtt"
        }
      ]
    },
    {
      "name": "classify_mqtt",
      "actionId": "com.datadoghq.core.if",
      "display": {
        "bounds": {
          "x": 384,
          "y": 384
        }
      },
      "parameters": [
        {
          "name": "joinOperator",
          "value": "and"
        },
        {
          "name": "conditions",
          "value": [
            {
              "comparisonOperator": "eq",
              "leftValue": "${ (() => { const c=Steps.read_operational_signals.data?.attributes?.columns || []; const v=Number(c.find(x=>x.name===\"mqtt_up\")?.values?.[0]); return Number.isFinite(v) && v<1; })() }",
              "rightValue": true
            }
          ]
        }
      ],
      "outboundEdges": [
        {
          "branchName": "true",
          "nextStepName": "mqtt_degraded"
        },
        {
          "branchName": "false",
          "nextStepName": "classify_ingest"
        }
      ]
    },
    {
      "name": "classify_ingest",
      "actionId": "com.datadoghq.core.if",
      "display": {
        "bounds": {
          "x": 768,
          "y": 384
        }
      },
      "parameters": [
        {
          "name": "joinOperator",
          "value": "and"
        },
        {
          "name": "conditions",
          "value": [
            {
              "comparisonOperator": "eq",
              "leftValue": "${ (() => { const c=Steps.read_operational_signals.data?.attributes?.columns || []; const l=Number(c.find(x=>x.name===\"ingest_lag_ms\")?.values?.[0]); const a=Number(c.find(x=>x.name===\"sample_age_s\")?.values?.[0]); return (Number.isFinite(l)&&l>5000)||(Number.isFinite(a)&&a>120); })() }",
              "rightValue": true
            }
          ]
        }
      ],
      "outboundEdges": [
        {
          "branchName": "true",
          "nextStepName": "ingest_delayed"
        },
        {
          "branchName": "false",
          "nextStepName": "no_dependency_breach"
        }
      ]
    },
    {
      "name": "mongo_degraded",
      "actionId": "com.datadoghq.core.echo",
      "display": {
        "bounds": {
          "x": 0,
          "y": 552
        }
      },
      "parameters": [
        {
          "name": "value",
          "value": "W5 | PROBABLE_DOMAIN=MONGODB | Mongo health metric is below healthy. Correlate Mongo logs/trace, persistence failures, MQTT state and ingest lag before assigning sole root cause; simultaneous faults may coexist. No restart."
        }
      ],
      "outboundEdges": [
        {
          "branchName": "main",
          "nextStepName": "notify_smiot_app"
        }
      ]
    },
    {
      "name": "common_dependency_degraded",
      "actionId": "com.datadoghq.core.echo",
      "display": {
        "bounds": {
          "x": 0,
          "y": 552
        }
      },
      "parameters": [
        {
          "value": "W5 | DOMAIN=COMMON_DEPENDENCY_FAILURE | MongoDB and MQTT health are both unavailable in the same observation window. Do not choose one root cause, do not restart infrastructure, and keep the incident unverified until independent recovery probes succeed.",
          "name": "value"
        }
      ],
      "outboundEdges": [
        {
          "branchName": "main",
          "nextStepName": "notify_smiot_app"
        }
      ]
    },
    {
      "name": "mqtt_degraded",
      "actionId": "com.datadoghq.core.echo",
      "display": {
        "bounds": {
          "x": 384,
          "y": 552
        }
      },
      "parameters": [
        {
          "name": "value",
          "value": "W5 | PROBABLE_DOMAIN=MQTT | Broker/consumer health metric is below healthy. Correlate MQTT logs/trace, Mongo persistence and ingest lag; simultaneous faults may coexist. No restart."
        }
      ],
      "outboundEdges": [
        {
          "branchName": "main",
          "nextStepName": "notify_smiot_app"
        }
      ]
    },
    {
      "name": "ingest_delayed",
      "actionId": "com.datadoghq.core.echo",
      "display": {
        "bounds": {
          "x": 768,
          "y": 552
        }
      },
      "parameters": [
        {
          "name": "value",
          "value": "W5 | PROBABLE_DOMAIN=INGEST_PATH | Ingest lag or sample age exceeds the configured triage threshold. Check publisher, broker, consumer, persistence and traces together; do not attribute cause from this signal alone. No restart."
        }
      ],
      "outboundEdges": [
        {
          "branchName": "main",
          "nextStepName": "notify_smiot_app"
        }
      ]
    },
    {
      "name": "no_dependency_breach",
      "actionId": "com.datadoghq.core.echo",
      "display": {
        "bounds": {
          "x": 768,
          "y": 552
        }
      },
      "parameters": [
        {
          "name": "value",
          "value": "W5 | NO_THRESHOLD_BREACH | Required metrics are present and within configured triage thresholds. This is not proof every dependency is healthy; retain the monitor event and inspect logs/traces if the user impact persists."
        }
      ],
      "outboundEdges": [
        {
          "branchName": "main",
          "nextStepName": "notify_smiot_app"
        }
      ]
    },
    {
      "name": "notify_smiot_app",
      "actionId": "com.datadoghq.http.request",
      "connectionLabel": "SMIOT_APP_HTTP",
      "parameters": [
        {
          "name": "verb",
          "value": "POST"
        },
        {
          "name": "url",
          "value": "https://13-238-30-218.sslip.io/api/integrations/datadog/notification"
        },
        {
          "name": "requestHeaders",
          "value": [
            {
              "key": "Content-Type",
              "value": [
                "application/json"
              ]
            }
          ]
        },
        {
          "name": "body",
          "value": "{\"event_id\":\"{{InstanceId}}\",\"workflow_name\":\"{{WorkflowName}}\",\"workflow_id\":\"{{WorkflowId}}\",\"message\":\"Datadog ran workflow {{WorkflowName}}. Classification is advisory only; exact incident/farm linkage and dependency recovery remain unverified. Keep the incident open until matching app, MongoDB, and MQTT evidence is correlated.\",\"category\":\"datadog\",\"severity\":\"warning\",\"workflow_run_id\":\"{{InstanceId}}\",\"status\":\"pending_verification\",\"verification_status\":\"pending\"}"
        }
      ],
      "readinessGate": {
        "thresholdType": "ANY"
      }
    }
  ],
  "handle": "smiot-w05-root-cause-triage",
  "triggers": [
    {
      "startStepNames": [
        "read_operational_signals"
      ],
      "monitorTrigger": {
        "rateLimit": {
          "count": 4,
          "interval": "60s"
        }
      }
    },
    {
      "startStepNames": [
        "read_operational_signals"
      ],
      "apiTrigger": {}
    }
  ],
  "connectionEnvs": [
    {
      "env": "default",
      "connections": [
        {
          "connectionId": "0e1ab54b-a758-47ad-ab39-c9ab4e091dba",
          "label": "SMIOT_APP_HTTP"
        }
      ]
    }
  ]
}
