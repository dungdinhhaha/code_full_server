{
  "handle": "smiot-ca2-confirm-local-interlock",
  "inputSchema": {
    "parameters": [
      {
        "name": "farm_key",
        "type": "STRING",
        "defaultValue": "greenhouse_a"
      },
      {
        "name": "node_id",
        "type": "STRING",
        "defaultValue": "2"
      }
    ]
  },
  "triggers": [
    {
      "monitorTrigger": {
        "rateLimit": {
          "count": 1,
          "interval": "300s"
        }
      },
      "startStepNames": [
        "query_flatline_and_interlock"
      ]
    },
    {
      "startStepNames": [
        "query_flatline_and_interlock"
      ],
      "apiTrigger": {}
    }
  ],
  "steps": [
    {
      "name": "query_flatline_and_interlock",
      "actionId": "com.datadoghq.dd.metrics.queryScalarData",
      "display": {
        "bounds": {
          "x": 0,
          "y": 96
        }
      },
      "errorHandlers": [
        {
          "fallbackStepName": "Echo_query_failed",
          "retryStrategy": {
            "kind": "RETRY_STRATEGY_LINEAR",
            "linear": {
              "interval": "1s",
              "maxRetries": 1
            }
          }
        }
      ],
      "outboundEdges": [
        {
          "branchName": "main",
          "nextStepName": "verify_evidence_available"
        }
      ],
      "parameters": [
        {
          "name": "range",
          "value": "5m"
        },
        {
          "name": "queries",
          "value": [
            {
              "aggregator": "last",
              "data_source": "metrics",
              "name": "flatline",
              "query": "max:smiot.telemetry.sensor_flatline{farm:${ Trigger.farm_key || 'greenhouse_a' },node:${ Trigger.node_id || '2' }}"
            }
          ]
        },
        {
          "name": "formulas",
          "value": [
            {
              "formula": "flatline"
            }
          ]
        }
      ]
    },
    {
      "name": "verify_evidence_available",
      "actionId": "com.datadoghq.core.if",
      "display": {
        "bounds": {
          "x": 0,
          "y": 216
        }
      },
      "parameters": [
        {
          "name": "joinOperator",
          "value": "and"
        },
        {
          "name": "conditions",
          "value": [
            {
              "comparisonOperator": "eq",
              "leftValue": "${ (() => { const c=Steps.query_flatline_and_interlock.data?.attributes?.columns || []; const names=[\"flatline\"]; return names.every(k => { const v=Number(c.find(x=>x.name===k)?.values?.[0]); return Number.isFinite(v); }); })() }",
              "rightValue": true
            }
          ]
        }
      ],
      "outboundEdges": [
        {
          "branchName": "true",
          "nextStepName": "If_local_interlock_confirmed"
        },
        {
          "branchName": "false",
          "nextStepName": "escalate_missing_evidence"
        }
      ]
    },
    {
      "name": "If_local_interlock_confirmed",
      "actionId": "com.datadoghq.core.if",
      "display": {
        "bounds": {
          "x": 0,
          "y": 384
        }
      },
      "outboundEdges": [
        {
          "branchName": "true",
          "nextStepName": "Echo_local_interlock_confirmed"
        },
        {
          "branchName": "false",
          "nextStepName": "Echo_escalate_missing_evidence"
        }
      ],
      "parameters": [
        {
          "name": "joinOperator",
          "value": "and"
        },
        {
          "name": "conditions",
          "value": [
            {
              "comparisonOperator": "eq",
              "leftValue": "${ (() => { const cols=Steps.query_flatline_and_interlock.data?.attributes?.columns || []; const flatline=Number(cols.find(c=>c.name===\"flatline\")?.values?.[0]); return Number.isFinite(flatline) && flatline===1; })() }",
              "rightValue": true
            }
          ]
        }
      ]
    },
    {
      "name": "Echo_local_interlock_confirmed",
      "actionId": "com.datadoghq.core.echo",
      "display": {
        "bounds": {
          "x": 0,
          "y": 552
        }
      },
      "parameters": [
        {
          "name": "value",
          "value": "CA2 | SENSOR_FLATLINE_OBSERVED | backend metric reports the Node 2 flatline signal | HOLD_ACK_UNVERIFIED | this read-only workflow cannot prove the app action ledger, exact incident/farm/node, fresh varying Mongo samples, or virtual PLC outputs-off ACK | ACTION=NONE | CLEAR_FORBIDDEN | operator/app verifier must correlate the exact incident before recovery"
        }
      ],
      "outboundEdges": [
        {
          "branchName": "main",
          "nextStepName": "notify_smiot_app"
        }
      ]
    },
    {
      "name": "Echo_escalate_missing_evidence",
      "actionId": "com.datadoghq.core.echo",
      "display": {
        "bounds": {
          "x": 384,
          "y": 552
        }
      },
      "parameters": [
        {
          "name": "value",
          "value": "CA2 | ESCALATE_HUMAN | flatline is not currently confirmed or metric value is unavailable | check the monitor group, source freshness, app action ledger and virtual PLC ACK | no HOLD/CLEAR from Datadog | DECISION=UNKNOWN_OR_NO_TRIGGER | ACTION=NONE | NEXT=operator review; retain uncertainty"
        }
      ],
      "outboundEdges": [
        {
          "branchName": "main",
          "nextStepName": "notify_smiot_app"
        }
      ]
    },
    {
      "name": "Echo_query_failed",
      "actionId": "com.datadoghq.core.echo",
      "display": {
        "bounds": {
          "x": 384,
          "y": 552
        }
      },
      "parameters": [
        {
          "name": "value",
          "value": "CA2 | ESCALATE_HUMAN | Datadog flatline metric query failed | app/virtual PLC interlock remains unverified | no actuator action and no auto-CLEAR | DECISION=UNKNOWN_OR_NO_TRIGGER | ACTION=NONE | NEXT=operator review; retain uncertainty"
        }
      ],
      "outboundEdges": [
        {
          "branchName": "main",
          "nextStepName": "notify_smiot_app"
        }
      ]
    },
    {
      "name": "escalate_missing_evidence",
      "actionId": "com.datadoghq.core.echo",
      "display": {
        "bounds": {
          "x": 384,
          "y": 552
        }
      },
      "parameters": [
        {
          "name": "value",
          "value": "W2 | DECISION=UNKNOWN | EVIDENCE=required metric column missing or non-numeric | ACTION=NONE | NEXT=operator checks telemetry source and monitor window; do not mark recovered"
        }
      ],
      "outboundEdges": [
        {
          "branchName": "main",
          "nextStepName": "notify_smiot_app"
        }
      ]
    },
    {
      "name": "notify_smiot_app",
      "actionId": "com.datadoghq.http.request",
      "connectionLabel": "SMIOT_APP_HTTP",
      "parameters": [
        {
          "name": "verb",
          "value": "POST"
        },
        {
          "name": "url",
          "value": "https://13-238-30-218.sslip.io/api/integrations/datadog/notification"
        },
        {
          "name": "requestHeaders",
          "value": [
            {
              "key": "Content-Type",
              "value": [
                "application/json"
              ]
            }
          ]
        },
        {
          "name": "body",
          "value": "{\"event_id\":\"{{InstanceId}}\",\"workflow_name\":\"{{WorkflowName}}\",\"workflow_id\":\"{{WorkflowId}}\",\"farm_key\":\"${ Trigger.farm_key || 'greenhouse_a' }\",\"node_id\":\"${ Trigger.node_id || '2' }\",\"message\":\"Datadog ran workflow {{WorkflowName}}. This workflow is read-only: flatline observation is not HOLD or recovery proof. Correlation remains unverified until the app links the exact incident, farm/node, HOLD ACK, fresh varying Mongo samples, and safe outputs.\",\"category\":\"datadog\",\"severity\":\"warning\",\"workflow_run_id\":\"{{InstanceId}}\",\"status\":\"pending_verification\",\"verification_status\":\"pending\"}"
        }
      ],
      "readinessGate": {
        "thresholdType": "ANY"
      }
    }
  ],
  "connectionEnvs": [
    {
      "env": "default",
      "connections": [
        {
          "connectionId": "0e1ab54b-a758-47ad-ab39-c9ab4e091dba",
          "label": "SMIOT_APP_HTTP"
        }
      ]
    }
  ]
}
