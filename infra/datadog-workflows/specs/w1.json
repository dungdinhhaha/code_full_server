{
  "steps": [
    {
      "display": {
        "bounds": {
          "y": 96,
          "x": 0
        }
      },
      "errorHandlers": [
        {
          "fallbackStepName": "escalate_query_failed",
          "retryStrategy": {
            "linear": {
              "interval": "1s",
              "maxRetries": 1
            },
            "kind": "RETRY_STRATEGY_LINEAR"
          }
        }
      ],
      "name": "read_operational_signals",
      "actionId": "com.datadoghq.dd.metrics.queryScalarData",
      "outboundEdges": [
        {
          "branchName": "main",
          "nextStepName": "verify_evidence_available"
        }
      ],
      "parameters": [
        {
          "value": "10m",
          "name": "range"
        },
        {
          "value": [
            {
              "aggregator": "last",
              "name": "safety_trip_by_farm_fault",
              "query": "sum:smiot.virtual_plc.safety_trip{source:smiot_demo_stream,event:safety_trip} by {farm,fault_code}",
              "data_source": "metrics"
            }
          ],
          "name": "queries"
        },
        {
          "value": [
            {
              "formula": "safety_trip_by_farm_fault"
            }
          ],
          "name": "formulas"
        }
      ]
    },
    {
      "name": "verify_evidence_available",
      "actionId": "com.datadoghq.core.if",
      "display": {
        "bounds": {
          "x": 0,
          "y": 216
        }
      },
      "parameters": [
        {
          "name": "joinOperator",
          "value": "and"
        },
        {
          "name": "conditions",
          "value": [
            {
              "comparisonOperator": "eq",
              "leftValue": "${ (() => { const c=Steps.read_operational_signals.data?.attributes?.columns || []; const names=[\"safety_trip_by_farm_fault\"]; return names.every(k => { const v=Number(c.find(x=>x.name===k)?.values?.[0]); return Number.isFinite(v); }); })() }",
              "rightValue": true
            }
          ]
        }
      ],
      "outboundEdges": [
        {
          "branchName": "true",
          "nextStepName": "classify_evidence"
        },
        {
          "branchName": "false",
          "nextStepName": "escalate_missing_evidence"
        }
      ]
    },
    {
      "display": {
        "bounds": {
          "x": 0,
          "y": 384
        }
      },
      "name": "classify_evidence",
      "outboundEdges": [
        {
          "nextStepName": "evidence_observed",
          "branchName": "true"
        },
        {
          "nextStepName": "escalate_or_review",
          "branchName": "false"
        }
      ],
      "parameters": [
        {
          "value": "and",
          "name": "joinOperator"
        },
        {
          "value": [
            {
              "comparisonOperator": "eq",
              "leftValue": "${ (() => { const c=Steps.read_operational_signals.data?.attributes?.columns || []; const v=Number(c.find(x=>x.name===\"safety_trip_by_farm_fault\")?.values?.[0]); return Number.isFinite(v) && v>0; })() }",
              "rightValue": true
            }
          ],
          "name": "conditions"
        }
      ],
      "actionId": "com.datadoghq.core.if"
    },
    {
      "display": {
        "bounds": {
          "y": 552,
          "x": 0
        }
      },
      "name": "evidence_observed",
      "parameters": [
        {
          "value": "W1 | SAFETY_TRIP_EVIDENCE_SEEN | Check incident and action ledger for local PLC trip/ACK, verify flow/pressure evidence, then hand off. This workflow did not stop the pump; the virtual PLC interlock owns that action. | RECORD=workflow run and linked monitor event | VERIFY=check app action ledger and fresh telemetry before marking recovered; Echo is not recovery proof",
          "name": "value"
        }
      ],
      "actionId": "com.datadoghq.core.echo",
      "outboundEdges": [
        {
          "branchName": "main",
          "nextStepName": "notify_smiot_app"
        }
      ]
    },
    {
      "display": {
        "bounds": {
          "y": 552,
          "x": 0
        }
      },
      "name": "escalate_or_review",
      "parameters": [
        {
          "value": "W1 | NO_TRIP_SIGNAL | The safety-trip metric is present and zero in the query window. Confirm local PLC status and incident timeline; do not claim a trip or send a Datadog actuator command.",
          "name": "value"
        }
      ],
      "actionId": "com.datadoghq.core.echo",
      "outboundEdges": [
        {
          "branchName": "main",
          "nextStepName": "notify_smiot_app"
        }
      ]
    },
    {
      "display": {
        "bounds": {
          "y": 552,
          "x": 0
        }
      },
      "name": "escalate_query_failed",
      "parameters": [
        {
          "value": "SMIOT | W1 | Verify PLC safety trip evidence | DECISION=UNKNOWN | EVIDENCE=QUERY_ERROR | ACTION=NONE | NEXT=OPERATOR | Evidence unavailable; fail closed and hand to an operator. No actuator or infrastructure action.",
          "name": "value"
        }
      ],
      "actionId": "com.datadoghq.core.echo",
      "outboundEdges": [
        {
          "branchName": "main",
          "nextStepName": "notify_smiot_app"
        }
      ]
    },
    {
      "name": "escalate_missing_evidence",
      "actionId": "com.datadoghq.core.echo",
      "display": {
        "bounds": {
          "x": 384,
          "y": 552
        }
      },
      "parameters": [
        {
          "name": "value",
          "value": "W1 | DECISION=UNKNOWN | EVIDENCE=required metric column missing or non-numeric | ACTION=NONE | NEXT=operator checks telemetry source and monitor window; do not mark recovered"
        }
      ],
      "outboundEdges": [
        {
          "branchName": "main",
          "nextStepName": "notify_smiot_app"
        }
      ]
    },
    {
      "name": "notify_smiot_app",
      "actionId": "com.datadoghq.http.request",
      "connectionLabel": "SMIOT_APP_HTTP",
      "parameters": [
        {
          "name": "verb",
          "value": "POST"
        },
        {
          "name": "url",
          "value": "https://13-238-30-218.sslip.io/api/integrations/datadog/notification"
        },
        {
          "name": "requestHeaders",
          "value": [
            {
              "key": "Content-Type",
              "value": [
                "application/json"
              ]
            }
          ]
        },
        {
          "name": "body",
          "value": "{\"event_id\":\"{{InstanceId}}\",\"workflow_name\":\"{{WorkflowName}}\",\"workflow_id\":\"{{WorkflowId}}\",\"message\":\"Datadog ran workflow {{WorkflowName}}. Open run {{InstanceId}} to review the result and next step. Correlation remains unverified: this workflow context does not supply a verified incident, farm, or scenario-run ID.\",\"category\":\"datadog\",\"severity\":\"info\",\"workflow_run_id\":\"{{InstanceId}}\",\"status\":\"investigating\",\"verification_status\":\"unknown\"}"
        }
      ],
      "readinessGate": {
        "thresholdType": "ANY"
      }
    }
  ],
  "handle": "smiot-w01-plc-safety-trip",
  "triggers": [
