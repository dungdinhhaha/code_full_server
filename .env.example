# Local development only. This URI points to MongoDB on this computer.
MONGODB_URI=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_DATABASE=smiot
MONGODB_TELEMETRY_COLLECTION=telemetry

# Keep synthetic seed/publisher off until you choose to enable the demo.
SMIOT_DEMO_MODE=false

# Datadog is optional for local UI development.
DATADOG_METRICS_ENABLED=false
DATADOG_APM_ENABLED=false
DATADOG_LLMOBS_ENABLED=false
DD_SITE=datadoghq.com
